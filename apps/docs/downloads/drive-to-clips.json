      "name": "Download video",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "4665386a-de31-566c-9614-d16000b36dec",
      "name": "One file at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        330,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Idempotency keys come from the execution, the Drive file, and the action,\n// so several files in one run never collide and a retried request replays.\nconst out = [];\nfor (let index = 0; index < $input.all().length; index++) {\n  const item = $input.all()[index];\n  const buffer = await this.helpers.getBinaryDataBuffer(index, 'data');\n  const keys = (action) => `${$execution.id}:${item.json.id}:${action}`;\n  out.push({\n    json: {\n      fileId: item.json.id,\n      file: { name: item.binary.data.fileName || item.json.name, sizeBytes: buffer.length, contentType: item.binary.data.mimeType || 'video/mp4' },\n      keys: { open: keys('open'), export: keys('export') },\n    },\n    binary: item.binary,\n  });\n}\nreturn out;"
      },
