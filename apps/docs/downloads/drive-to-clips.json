        "jsCode": "// Re-read every tracked operation and decide whether to keep waiting.\nconst ids = $('Track exports').first().json.operationIds;\nconst statuses = $input.all().map((item) => item.json);\nconst terminal = statuses.every((status) => status.state !== 'working');\nreturn [{ json: { terminal, statuses, operationIds: ids } }];"
