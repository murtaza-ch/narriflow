    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Verify the Standard Webhooks signature, then accept only a new event for an\n// operation this execution is waiting on. Anything else waits again.\nconst crypto = require('crypto');\nlet secret = $vars.NARRIFLOW_CALLBACK_SECRET;\ntry { secret = secret || $env.NARRIFLOW_CALLBACK_SECRET; } catch {}\nif (!secret) throw new Error('Set the NARRIFLOW_CALLBACK_SECRET variable (whsec_\u2026) from Narriflow Settings \u2192 API');\nconst key = Buffer.from(secret.replace(/^whsec_/, ''), 'base64');\nconst waiting = new Set($('Track operations').first().json.operationIds);\nconst seen = $getWorkflowStaticData('global');\nseen.narriflowEvents = seen.narriflowEvents || {};\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst id = headers['webhook-id'];\nconst timestamp = Number(headers['webhook-timestamp']);\n// The raw body is binary data; n8n may keep it in filesystem or S3 storage.\nconst raw = item.binary && item.binary.data\n  ? (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8')\n  : JSON.stringify(item.json.body);\nconst expected = crypto.createHmac('sha256', key).update(`${id}.${timestamp}.${raw}`).digest('base64');\nconst offered = String(headers['webhook-signature'] || '').split(' ').map((part) => part.split(',')[1]);\nconst fresh = Math.abs(Date.now() / 1000 - timestamp) < 300;\nconst signed = offered.some((signature) => signature && signature.length === expected.length\n  && crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected)));\nlet event = null;\ntry { event = JSON.parse(raw); } catch {}\nconst accepted = Boolean(signed && fresh && event && event.id === id\n  && waiting.has(event.data.operationId) && !seen.narriflowEvents[id]);\nif (accepted) seen.narriflowEvents[id] = Date.now();\nreturn [{ json: { accepted, eventId: id || null, operationId: event?.data?.operationId ?? null } }];"
      },
