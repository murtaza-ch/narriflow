# Database
DATABASE_URL=postgresql://user:password@localhost:5432/narriflow

# MCP user scope
# Set to the Narriflow User.id this local MCP server should act as.
NARRIFLOW_MCP_USER_ID=
# Optional. Defaults to the user's personal workspace; when set, membership is
# validated before every MCP operation.
NARRIFLOW_MCP_WORKSPACE_ID=
