# Database (stdio server only; the CLI upload helper does not read it)
DATABASE_URL=postgresql://user:password@localhost:5432/narriflow

# Narriflow API origin (A): the stdio server's resource URL and the CLI upload helper's
# target. Hosted: the Railway API origin. Never the web app's origin.
NARRIFLOW_URL=http://localhost:4000
# Human links the stdio server returns (review rooms, handoffs) point at the web app (W).
WEB_ORIGIN=http://localhost:3000

# Workspace-scoped Business API key created in Narriflow Settings -> Developer access.
NARRIFLOW_API_KEY=
