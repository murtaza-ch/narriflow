{
  "version": 1,
  "description": "Render hardening golden fixtures (ticket 01). Recipes regenerate every fixture deterministically with the pinned FFmpeg; sha256ByToolchain pins the bytes for the FFmpeg/x264 build that produced them.",
  "cacheEnv": "NARRIFLOW_GOLDEN_CACHE",
  "defaultCache": "~/.cache/narriflow-render-golden",
  "encoder": {
    "preset": "veryfast",
    "crf": "21"
  },
  "fixtures": {
    "talk-720p": {
      "file": "talk-720p.mp4",
      "kind": "video",
      "description": "1280x720 30fps 5s testsrc2, stereo 48k; white flash and 1500 Hz burst at 1.0s and 3.0s",
      "steps": [
        [
          "-f",
          "lavfi",
          "-i",
          "testsrc2=s=1280x720:r=30:d=5",
          "-f",
          "lavfi",
          "-i",
          "sine=f=330:sample_rate=48000:d=5",
          "-f",
          "lavfi",
          "-i",
          "sine=f=1500:sample_rate=48000:d=5",
          "-filter_complex",
          "[0:v]drawbox=x=0:y=0:w=iw:h=ih:color=white@1:t=fill:enable='between(t,1,1.1)+between(t,3,3.1)',format=yuv420p[v];[1:a]volume=0.8[a0];[2:a]volume='3.2*(between(t,1,1.1)+between(t,3,3.1))':eval=frame[a1];[a0][a1]amix=inputs=2:normalize=0,aformat=channel_layouts=stereo[a]",
          "-map",
          "[v]",
          "-map",
          "[a]",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "18",
          "-pix_fmt",
          "yuv420p",
          "-threads",
          "1",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-fflags",
          "+bitexact",
          "-flags:v",
          "+bitexact",
          "-flags:a",
          "+bitexact",
          "-map_metadata",
          "-1",
          "-movflags",
          "+faststart",
          "{out}"
        ]
      ],
      "sha256ByToolchain": {
        "61eaae45762c8f89": "42ddcf5df76717c4c37e9f816308e61338a57dea6a23270a8075f0b33f488104"
