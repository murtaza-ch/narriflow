{
  "name": "@narriflow/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "bun run src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/",
    "retention:replay-tombstones": "bun run src/replay-retention-tombstones.ts",
    "reconcile:render-objects": "bun run src/reconcile-render-objects.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@narriflow/composition-plan": "workspace:*",
    "@narriflow/db": "workspace:*",
    "@narriflow/email": "workspace:*",
    "@narriflow/services": "workspace:*",
    "@narriflow/validators": "workspace:*",
    "archiver": "7.0.1"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/node": "26.2.0"
  }
}
