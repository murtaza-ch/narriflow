{
  "name": "@narriflow/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "bun run src/index.ts",
    "lint": "echo 'worker lint: no-op'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/",
    "retention:replay-tombstones": "bun run src/replay-retention-tombstones.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@narriflow/email": "workspace:*",
    "@narriflow/services": "workspace:*",
    "@narriflow/validators": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  }
}
