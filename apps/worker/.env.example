# Runtime
NODE_ENV=development
PORT=4001
# Base tick for the per-stage claim loops (ingest, stt, moment_detection,
# dubbing, publish). Render/preview default to the same value unless
# overridden below.
INGEST_POLL_INTERVAL_MS=2500
RENDER_POLL_INTERVAL_MS=2500
PREVIEW_POLL_INTERVAL_MS=2500
# Independent, low-concurrency analysis of clip preview proxies. Disable only
# as an operational rollback; the renderer retains an on-demand fallback.
AUTO_LAYOUT_POLL_INTERVAL_MS=10000
WORKER_AUTO_LAYOUT_BATCH_SIZE=2
# Durable per-clip lease/backoff shared by every worker replica. Keep the
# lease above the 120s detector timeout plus proxy download overhead.
WORKER_AUTO_LAYOUT_LEASE_MS=180000
WORKER_AUTO_LAYOUT_FAILURE_BACKOFF_MS=300000
# WORKER_AUTO_LAYOUT_ANALYSIS=0
# Submit-and-release STT: the stt loop only submits to AssemblyAI; this loop
# polls for results. Per-run cadence is additionally gated by
# ASSEMBLYAI_POLL_INTERVAL_MS via the claim lease.
STT_RESULT_POLL_INTERVAL_MS=5000
STT_RESULT_POLL_BATCH_SIZE=10
WORKER_MAX_CONSECUTIVE_POLL_FAILURES=20
WORKER_REAP_INTERVAL_MS=300000
WORKER_REAP_STALL_TIMEOUT_MS=1800000
WEBHOOK_LOG_RETENTION_DAYS=30

# Ingest. Parallel fragment downloads only affect DASH/HLS sources (YouTube);
# they routinely 2-4x the download leg on fast connections.
YTDLP_CONCURRENT_FRAGMENTS=4

# Storage transfer. Multipart parts are 16MB; memory bound for uploads is
# concurrency x 16MB. Speeds up both the ingest source upload and render
# output uploads.
R2_MULTIPART_CONCURRENCY=4

# Render source input. "ranged" (default) hands ffmpeg a presigned URL so each
# clip encode range-requests only its own window of the source — for a 2h
# podcast that reads ~5-8% of the bytes instead of downloading the whole file
# first. "download" restores the old full-file download; any presign/probe
# failure also falls back to it automatically per run.
WORKER_RENDER_SOURCE_MODE=ranged
# Per-invocation wall-clock bound on render ffmpeg/ffprobe children. With
# ranged reads a quiet TCP stall could otherwise hang an encode (and its poll
# loop) forever — -rw_timeout alone provably doesn't cover every stall mode.
WORKER_RENDER_FFMPEG_TIMEOUT_MS=1800000

# Email notifications
# Required in production; must be the public web-app origin, never localhost.
WORKER_APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
NARRIFLOW_EMAIL_FROM=Narriflow <no-reply@narriflow.app>
NOTIFICATION_RETRY_POLL_INTERVAL_MS=60000
NOTIFICATION_RETRY_BATCH_SIZE=25

# Retention. Source media is the dominant storage cost (~2.65 GB per source-hour,
# kept forever before this existed). Sources are only purged once the project is
# terminal and its renders exist, and sourceStorageKey is nulled so the UI can
# show "source expired" rather than a broken link.
SOURCE_RETENTION_DAYS=90
WORKFLOW_EVENT_RETENTION_DAYS=90

# Encoder. Encoding is ~73% of render wall-clock. veryfast/21 measured
# quality-neutral against the previous medium/23 while cutting encode time
# substantially. Raise the preset only if you can show a quality regression.
WORKER_X264_PRESET=veryfast
WORKER_X264_CRF=21

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/narriflow

# Workflow events
# Required if web and worker run as separate processes and you want live SSE updates.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Legacy / reserved for future Trigger.dev work. The current ingest + STT flow does not use it.
TRIGGER_SECRET_KEY=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI
OPENAI_API_KEY=
OPENAI_CLIP_MODEL=gpt-5.4-mini
OPENAI_CLIP_REASONING_EFFORT=medium
# Runaway backstop for the detection call (includes reasoning tokens on this
# model family). Long podcasts legitimately produce large candidate lists —
# keep this generous; a capped response fails as clip_detection_truncated.
OPENAI_CLIP_MAX_OUTPUT_TOKENS=32000
OPENAI_CONTENT_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_DUB_TRANSLATION_MODEL=gpt-5.4-mini
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_POLL_INTERVAL_MS=5000
ASSEMBLYAI_POLL_TIMEOUT_MS=7200000

# Stock B-roll
PEXELS_API_KEY=

# Native social publishing
# Must match the web value. Generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v20.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606
X_CLIENT_ID=
X_CLIENT_SECRET=
SOCIAL_PUBLISH_BATCH_SIZE=5

# Legacy publisher webhook fallback
# Used only for scheduled posts that do not have a connected social account.
SOCIAL_PUBLISH_WEBHOOK_URL=
SOCIAL_PUBLISH_WEBHOOK_SECRET=

# Autopilot
AUTOPILOT_BATCH_SIZE=3

# Face-detection runtime (docs/agent/setup.md "Face-detection runtime") —
# without these, all face-tracked framing degrades to static center crops.
# REFRAME_PYTHON=/abs/path/to/apps/worker/.venv/bin/python
# REFRAME_MODEL_PATH=/abs/path/to/apps/worker/models/face_yunet.onnx
# Layout-engine kill switch (default on) + scene-cut sensitivity (default 0.3):
# WORKER_LAYOUT_ENGINE=0
# REFRAME_SCENE_THRESHOLD=0.3
# Face samples per second. Four balances mouth-motion attribution and worker
# cost; raise only after profiling the target deployment CPU.
# REFRAME_SAMPLE_FPS=4
