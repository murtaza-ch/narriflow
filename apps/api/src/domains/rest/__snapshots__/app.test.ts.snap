                  "brand_default",
                  "bold-pop",
                  "blast",
                  "punch",
                  "spotlight",
                  "street",
                  "electric",
                  "rise",
                  "focus",
                  "glass",
                  "sticker",
                  "frosted-glass",
                  "highlighter",
                  "bubblegum",
                  "jelly",
                  "candy",
                  "retro",
                  "afterglow",
                  "cinema",
                  "karaoke",
                  "neon",
                  "glitch",
                  "flip",
                  "typewriter",
                  "block",
                ],
                "type": "string",
              },
              "clipCountTarget": {
                "default": 10,
                "maximum": 30,
                "minimum": 3,
                "type": "integer",
              },
              "clipLengthPreset": {
                "default": "auto",
                "enum": [
                  "auto",
                  "under_30s",
                  "30_to_60s",
                  "60_to_120s",
                  "120_to_180s",
                ],
                "type": "string",
              },
              "defaultAspectRatio": {
