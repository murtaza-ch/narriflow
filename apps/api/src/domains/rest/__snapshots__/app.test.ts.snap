    "/api/v1/social-posts/proposals": {
      "post": {
        "description": "Adds a clip's finished export to an account's Publishing Queue as a draft. Nothing publishes: a person accepts the proposal in Narriflow, which freezes it into the account's next free posting slot and applies the Brand Profile's approval rule. The caption defaults to the latest assisted copy for the platform, if any. Retrying with the same Idempotency-Key returns the original proposal.",
        "parameters": [
          {
            "description": "1–200 URL-safe characters. Retrying with the same key and input returns the original result; different input under the same key is a conflict.",
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "description": "1–200 URL-safe characters. Retrying with the same key and input returns the original result; different input under the same key is a conflict.",
              "pattern": "^[A-Za-z0-9._~:-]{1,200}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeSocialPostRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposedSocialPostResult",
                },
              },
            },
            "description": "The proposal",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid request",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Missing or invalid API key",
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Plan or billing refusal. \`plan_feature_required\` and \`plan_limit_reached\` name the feature or limit, the current tier, and the required tier in \`details\`; \`credits_exhausted\` reports the month's credits; \`integration_access_unavailable\` means the Workspace isn't active",
          },
          "403": {
