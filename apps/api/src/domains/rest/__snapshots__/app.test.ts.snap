      "FinishingSettings": {
        "additionalProperties": false,
        "properties": {
          "aspectRatios": {
            "description": "Export formats; omitted means the generation's default aspect ratio",
            "items": {
              "enum": [
                "9:16",
                "1:1",
                "16:9",
                "4:5",
              ],
              "type": "string",
            },
            "maxItems": 4,
            "minItems": 1,
            "type": "array",
          },
          "copyPlatforms": {
            "default": [],
            "description": "Write assisted copy for each picked clip on these platforms",
            "items": {
              "enum": [
                "tiktok",
                "youtube_shorts",
                "instagram_reels",
                "facebook_reels",
                "linkedin",
                "x",
              ],
              "type": "string",
            },
            "maxItems": 6,
            "type": "array",
          },
          "delivery": {
            "default": "ready_to_review",
            "description": "What happens after finishing: stop at ready_to_review, propose each picked clip to the queue accounts for a person to accept (propose_to_queue also needs the publishing:write scope), or send the finished exports to the reviewers of a standing grant as a Review Round (send_review_round belongs to an Autopilot rule and needs an active grant)",
            "enum": [
              "ready_to_review",
              "propose_to_queue",
              "send_review_round",
            ],
            "type": "string",
          },
          "minScore": {
            "default": 0,
            "description": "Skip clips whose virality score is below this",
            "maximum": 100,
            "minimum": 0,
            "type": "integer",
          },
          "queueAccountIds": {
            "default": [],
            "description": "With propose_to_queue: the connected accounts each picked clip is proposed to, using that platform's copy",
            "items": {
              "format": "uuid",
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "resolution": {
            "default": "1080p",
            "description": "The plan's own resolution limit still applies",
            "enum": [
              "720p",
              "1080p",
            ],
            "type": "string",
          },
          "topClips": {
            "description": "Export this many of the generation's highest-scoring clips",
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
          },
        },
        "required": [
          "topClips",
        ],
        "type": "object",
      },
