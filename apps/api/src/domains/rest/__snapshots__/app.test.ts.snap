                "postingSchedule",
                "publishingEligible",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "timeZone": {
            "description": "The Workspace time zone that posting slots are in",
            "maxLength": 100,
            "type": "string",
          },
        },
        "required": [
          "accounts",
          "timeZone",
        ],
        "type": "object",
      },
      "SubmitVideoRequest": {
        "additionalProperties": false,
        "properties": {
          "brandProfileId": {
            "description": "Omit to use the Workspace default Brand Profile",
            "format": "uuid",
            "type": "string",
          },
          "callback": {
            "$ref": "#/components/schemas/CallbackRequest",
          },
          "finishing": {
            "$ref": "#/components/schemas/FinishingSettings",
          },
          "generation": {
            "$ref": "#/components/schemas/GenerationSettings",
          },
          "recipeId": {
            "description": "A Recipe from the Recipes list. It replaces brandProfileId, generation, and finishing: send it or those, never both. Generating clips for an existing Project uses the Recipe's language, generation settings, and finishing; the Project keeps the Brand Profile it was imported with",
            "format": "uuid",
            "type": "string",
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "url": {
            "description": "A supported video link",
            "format": "uri",
            "maxLength": 4096,
            "type": "string",
          },
        },
        "required": [
          "url",
        ],
        "type": "object",
      },
      "Upload": {
        "additionalProperties": false,
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": [
              "string",
              "null",
            ],
          },
          "failureCode": {
            "type": [
              "string",
              "null",
            ],
          },
          "operation": {
            "additionalProperties": false,
            "description": "The upload intake, once finalize accepts it",
            "properties": {
              "kind": {
                "enum": [
                  "intake",
                  "generation",
                  "export",
                ],
                "type": "string",
              },
              "operationId": {
                "type": "string",
              },
              "statusUrl": {
                "format": "uri",
                "type": "string",
              },
            },
            "required": [
              "operationId",
              "kind",
              "statusUrl",
            ],
            "type": [
              "object",
              "null",
            ],
          },
          "projectId": {
            "format": "uuid",
            "type": [
              "string",
              "null",
            ],
          },
          "recipe": {
            "additionalProperties": false,
            "description": "The Recipe and revision a session opened with a recipeId used. Returned by the open request",
            "properties": {
              "id": {
                "format": "uuid",
                "type": "string",
              },
              "revision": {
                "exclusiveMinimum": 0,
                "type": "integer",
              },
            },
            "required": [
              "id",
              "revision",
            ],
            "type": "object",
          },
          "retryAfterSeconds": {
            "exclusiveMinimum": 0,
            "type": [
              "integer",
              "null",
            ],
          },
          "state": {
            "enum": [
              "uploading",
              "reconciling",
              "queued_for_ingest",
              "terminal",
              "discarded",
              "compensating",
            ],
            "type": "string",
          },
          "transfer": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "headers": {
                    "additionalProperties": {
                      "type": "string",
                    },
                    "type": "object",
                  },
                  "kind": {
                    "enum": [
                      "single",
                    ],
                    "type": "string",
                  },
                  "method": {
                    "enum": [
                      "PUT",
                    ],
                    "type": "string",
                  },
                  "url": {
                    "format": "uri",
                    "type": "string",
                  },
                },
                "required": [
                  "kind",
                  "method",
                  "url",
                  "headers",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "completedParts": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "etag": {
                          "type": "string",
                        },
                        "partNumber": {
                          "type": "integer",
                        },
                      },
                      "required": [
                        "partNumber",
                        "etag",
                      ],
                      "type": "object",
                    },
                    "type": "array",
                  },
                  "concurrency": {
                    "type": "integer",
                  },
                  "grantExpiresAt": {
                    "format": "date-time",
                    "type": "string",
                  },
                  "kind": {
                    "enum": [
                      "multipart",
                    ],
                    "type": "string",
                  },
                  "partCount": {
                    "type": "integer",
                  },
                  "partSizeBytes": {
                    "type": "integer",
                  },
                  "parts": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "partNumber": {
                          "type": "integer",
                        },
                        "url": {
                          "format": "uri",
                          "type": "string",
                        },
                      },
                      "required": [
                        "partNumber",
                        "url",
                      ],
                      "type": "object",
                    },
                    "type": "array",
                  },
                },
                "required": [
                  "kind",
                  "partSizeBytes",
                  "partCount",
                  "concurrency",
                  "parts",
                  "grantExpiresAt",
                  "completedParts",
                ],
                "type": "object",
              },
              {
                "type": "null",
              },
            ],
            "description": "Signed storage URLs. Never log or share them.",
          },
          "uploadId": {
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "uploadId",
          "state",
          "projectId",
          "expiresAt",
          "transfer",
          "retryAfterSeconds",
          "failureCode",
          "operation",
        ],
        "type": "object",
      },
      "UploadResult": {
        "additionalProperties": false,
        "properties": {
          "callback": {
            "$ref": "#/components/schemas/AcceptedCallback",
          },
          "upload": {
            "$ref": "#/components/schemas/Upload",
          },
        },
        "required": [
          "upload",
        ],
        "type": "object",
      },
      "Webhook": {
        "additionalProperties": false,
        "properties": {
          "consecutiveFailures": {
            "minimum": 0,
            "type": "integer",
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
          },
          "disabledAt": {
            "format": "date-time",
            "type": [
              "string",
              "null",
            ],
          },
          "disabledReason": {
            "enum": [
              "consecutive_failures",
              "cursor_expired",
              "endpoint_gone",
              null,
            ],
            "type": [
              "string",
              "null",
            ],
          },
          "lastAttemptAt": {
            "format": "date-time",
            "type": [
              "string",
              "null",
            ],
          },
          "lastDeliveredAt": {
            "format": "date-time",
            "type": [
              "string",
              "null",
            ],
          },
          "lastDeliveredSeq": {
            "description": "Every matching event up to this seq has been acknowledged with a 2xx",
            "minimum": 0,
            "type": "integer",
          },
          "lastResponseStatus": {
            "description": "Null when the last attempt got no response",
            "type": [
              "integer",
              "null",
            ],
          },
          "status": {
            "enum": [
              "active",
              "disabled",
            ],
            "type": "string",
          },
          "types": {
            "items": {
              "enum": [
                "autopilot.episode_imported",
                "operation.finished",
                "finishing.finished",
                "social_post.proposed",
                "social_post.finished",
                "grant.paused",
                "grant.expired",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "urlHost": {
            "description": "The endpoint's host. The full URL is sealed and never returned",
            "type": "string",
          },
          "webhookId": {
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "webhookId",
          "urlHost",
          "types",
          "status",
          "disabledReason",
          "disabledAt",
          "lastDeliveredSeq",
          "consecutiveFailures",
          "lastAttemptAt",
          "lastResponseStatus",
          "lastDeliveredAt",
          "createdAt",
        ],
        "type": "object",
      },
      "WebhookResult": {
        "additionalProperties": false,
        "properties": {
          "webhook": {
            "$ref": "#/components/schemas/Webhook",
          },
        },
        "required": [
          "webhook",
        ],
        "type": "object",
      },
      "WebhookTestResult": {
        "additionalProperties": false,
        "properties": {
          "delivered": {
            "description": "True when the endpoint answered 2xx",
            "type": "boolean",
          },
          "durationMs": {
            "minimum": 0,
            "type": "integer",
          },
          "eventId": {
            "description": "The webhook-id of the webhook.test event",
            "format": "uuid",
            "type": "string",
          },
          "status": {
            "description": "The endpoint's HTTP status, or null when it didn't answer",
            "type": [
              "integer",
              "null",
            ],
          },
        },
        "required": [
          "eventId",
          "delivered",
          "status",
          "durationMs",
        ],
        "type": "object",
      },
      "WebhooksResult": {
        "additionalProperties": false,
        "properties": {
          "webhooks": {
            "items": {
              "$ref": "#/components/schemas/Webhook",
            },
            "type": "array",
          },
        },
        "required": [
          "webhooks",
        ],
        "type": "object",
      },
      "WorkspaceResult": {
        "additionalProperties": false,
        "properties": {
          "usage": {
            "additionalProperties": false,
            "properties": {
              "inFlight": {
                "description": "Videos currently processing",
                "minimum": 0,
                "type": "integer",
              },
              "inFlightLimit": {
                "description": "Videos the plan may process at once",
                "exclusiveMinimum": 0,
                "type": "integer",
              },
              "limitCredits": {
                "description": "Credits the plan includes each UTC month",
                "minimum": 0,
                "type": "integer",
              },
              "maxUploadSeconds": {
                "description": "Per-video duration limit",
                "minimum": 0,
                "type": "integer",
              },
              "periodStart": {
                "description": "Start of the UTC month these credits belong to",
                "format": "date-time",
                "type": "string",
              },
              "remainingCredits": {
                "description": "Credits available for new videos this month",
                "minimum": 0,
                "type": "integer",
              },
              "renewsAt": {
                "description": "When the next month's credits become available (UTC); unused credits don't roll over",
                "format": "date-time",
                "type": "string",
              },
              "reservedCredits": {
                "description": "Credits held for videos still importing",
                "minimum": 0,
                "type": "integer",
              },
              "tier": {
                "maxLength": 30,
                "type": "string",
              },
              "usedCredits": {
                "description": "Credits settled this UTC month. One credit is one started minute of source video, per video",
                "minimum": 0,
                "type": "integer",
              },
            },
            "required": [
              "tier",
              "usedCredits",
              "reservedCredits",
              "limitCredits",
              "remainingCredits",
              "periodStart",
              "renewsAt",
              "inFlight",
              "inFlightLimit",
              "maxUploadSeconds",
            ],
            "type": "object",
          },
          "workspace": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
              },
              "pricingTier": {
                "type": "string",
              },
              "role": {
                "enum": [
                  "owner",
                  "admin",
                  "editor",
                  "viewer",
                ],
                "type": "string",
              },
              "status": {
                "type": "string",
              },
              "workspaceId": {
                "format": "uuid",
                "type": "string",
              },
            },
            "required": [
              "workspaceId",
              "name",
              "role",
              "status",
              "pricingTier",
            ],
            "type": "object",
          },
        },
        "required": [
          "workspace",
          "usage",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "A Workspace API key (nf_…) from Settings → Developer access",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "description": "Turn long videos into short, captioned clips. Changes within v1 are additive.",
    "title": "Narriflow API",
    "version": "1.0.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/brand-profiles": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrandProfilesResult",
                },
              },
            },
            "description": "Brand Profiles",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid request",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Missing or invalid API key",
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Plan or billing refusal. \`plan_feature_required\` and \`plan_limit_reached\` name the feature or limit, the current tier, and the required tier in \`details\`; \`credits_exhausted\` reports the month's credits; \`integration_access_unavailable\` means the Workspace isn't active",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Scope, role, or Workspace boundary refusal",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Conflict, including an idempotency key reused with different input",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Unprocessable",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Rate limited; see Retry-After",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Temporarily unavailable; see Retry-After",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "List Brand Profiles",
        "tags": [
          "Workspace",
        ],
      },
    },
    "/api/v1/captioned-videos": {
      "post": {
        "description": "Captions a short, finished video, such as an AI-generated one, frames it Fit (the whole frame) or Center (a centered cover crop), and exports it at each requested format. There is no clip detection: the Project gets one clip, the whole video, up to 3 minutes. Captions come from the speech (auto), from SRT or WebVTT you supply, or are omitted (none); a video without an audio stream gets no speech captions. Send a link to import it (202), or describe a file to open an Upload Session that carries these settings (200), upload it, and finalize it with POST /uploads/{id}/finalize. Follow the work with GET /operations/{id}: its results name the export, and its notices report framing_degraded when Center crops part of the frame.",
        "parameters": [
          {
            "description": "1–200 URL-safe characters. Retrying with the same key and input returns the original result; different input under the same key is a conflict.",
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "description": "1–200 URL-safe characters. Retrying with the same key and input returns the original result; different input under the same key is a conflict.",
              "pattern": "^[A-Za-z0-9._~:-]{1,200}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptionedVideoRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult",
                },
              },
            },
            "description": "The Upload Session, for a file",
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedProjectOperation",
                },
              },
            },
            "description": "Accepted intake, for a link",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid request",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Missing or invalid API key",
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Plan or billing refusal. \`plan_feature_required\` and \`plan_limit_reached\` name the feature or limit, the current tier, and the required tier in \`details\`; \`credits_exhausted\` reports the month's credits; \`integration_access_unavailable\` means the Workspace isn't active",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Scope, role, or Workspace boundary refusal",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Conflict, including an idempotency key reused with different input",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Unprocessable",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Rate limited; see Retry-After",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Temporarily unavailable; see Retry-After",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Caption a finished video",
        "tags": [
          "Projects",
        ],
      },
    },
    "/api/v1/clips/{id}": {
      "get": {
        "parameters": [
          {
            "description": "Resource ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Resource ID",
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "includeTranscriptExcerpt",
            "required": false,
            "schema": {
              "default": "false",
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClipResult",
                },
              },
            },
            "description": "The clip",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid request",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Missing or invalid API key",
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Plan or billing refusal. \`plan_feature_required\` and \`plan_limit_reached\` name the feature or limit, the current tier, and the required tier in \`details\`; \`credits_exhausted\` reports the month's credits; \`integration_access_unavailable\` means the Workspace isn't active",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Scope, role, or Workspace boundary refusal",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Conflict, including an idempotency key reused with different input",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Unprocessable",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Rate limited; see Retry-After",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Temporarily unavailable; see Retry-After",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Get a clip",
        "tags": [
          "Clips",
        ],
      },
    },
    "/api/v1/clips/{id}/exports": {
      "post": {
        "description": "Exports the exact editor revision in the selected formats. The response reports any plan limit applied to resolution or watermark.",
        "parameters": [
          {
            "description": "Resource ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Resource ID",
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "description": "1–200 URL-safe characters. Retrying with the same key and input returns the original result; different input under the same key is a conflict.",
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "description": "1–200 URL-safe characters. Retrying with the same key and input returns the original result; different input under the same key is a conflict.",
              "pattern": "^[A-Za-z0-9._~:-]{1,200}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
