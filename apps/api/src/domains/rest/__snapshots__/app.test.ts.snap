    "/api/v1/events": {
      "get": {
        "description": "Polls what finished in this Workspace, including work no request started, such as an Autopilot import. Events are ordered by seq; pass the returned nextCursor as \`after\`. Delivery is at least once, so deduplicate by event id. Events expire after 30 days; re-sync from the list endpoints if a poller was down longer. order=desc returns the newest events, newest first, for pollers that read the newest page each time and deduplicate by id: at most limit (200) matching events per poll interval. Queue proposals (social_post.proposed) and posting outcomes (social_post.finished) need the publishing:read scope: a request that names only those types without it is refused with scope_required, and one that mixes them with other types gets the other types.",
        "parameters": [
          {
            "description": "A previous nextCursor; omit to start at the oldest retained event",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "description": "A previous nextCursor; omit to start at the oldest retained event",
              "pattern": "^\\d{1,15}$",
              "type": "string",
            },
          },
          {
            "description": "asc (default) reads forward from \`after\`. desc returns the newest \`limit\` matching events, newest first, and cannot be combined with \`after\`; its nextCursor is the highest seq on the page.",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "default": "asc",
              "description": "asc (default) reads forward from \`after\`. desc returns the newest \`limit\` matching events, newest first, and cannot be combined with \`after\`; its nextCursor is the highest seq on the page.",
              "enum": [
                "asc",
                "desc",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 200,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "description": "Comma-separated event types: autopilot.episode_imported, operation.finished, finishing.finished, social_post.proposed, social_post.finished, grant.paused, grant.expired",
            "in": "query",
            "name": "types",
            "required": false,
            "schema": {
              "description": "Comma-separated event types: autopilot.episode_imported, operation.finished, finishing.finished, social_post.proposed, social_post.finished, grant.paused, grant.expired",
              "maxLength": 200,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResult",
                },
              },
            },
            "description": "A page of events: in seq order, or newest first with order=desc",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid request",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Missing or invalid API key",
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Plan or billing refusal. \`plan_feature_required\` and \`plan_limit_reached\` name the feature or limit, the current tier, and the required tier in \`details\`; \`credits_exhausted\` reports the month's credits; \`integration_access_unavailable\` means the Workspace isn't active",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Scope, role, or Workspace boundary refusal",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Conflict, including an idempotency key reused with different input",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Unprocessable",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Rate limited; see Retry-After",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Temporarily unavailable; see Retry-After",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "List Workspace Events",
        "tags": [
          "Events",
        ],
      },
    },
