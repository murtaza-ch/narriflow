{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "narriflow-api-candidate",
  "account_id": "5359f28d385b8632c3abee12d1f5b011",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "disallow_importable_env"],
  "alias": { "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js" },
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 30000 },
  // Neon is in AWS us-east-2. Control commands make several transactional
  // round trips; run fetch handlers near that database.
  "placement": { "region": "aws:us-east-2" },
  "routes": [],
  // Each Cron registers one bounded metadata page; Workflows own continuation.
  // Fenced snapshots refuse Cron before DB access. Remove both with crons: []
  // while performing the explicit closed-mode restore redispatch procedure.
  "triggers": { "crons": ["0 * * * *", "0 0 * * *"] },
  "durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }, { "name": "PROJECT_PROGRESS", "class_name": "ProjectProgress" }, { "name": "LOCAL_FETCH_MAILBOX", "class_name": "LocalFetchMailbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter", "ProjectProgress", "LocalFetchMailbox"] }],
  "workflows": [
    { "binding": "IMPORT_PIPELINE", "name": "narriflow-import-candidate", "class_name": "ImportPipeline" },
    { "binding": "RENDER_RUN", "name": "narriflow-render-candidate", "class_name": "RenderRun" },
    { "binding": "OPERATION_DRIVER", "name": "narriflow-operation-candidate", "class_name": "OperationDriver" },
    { "binding": "MAINTENANCE", "name": "narriflow-maintenance-candidate", "class_name": "Maintenance" }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "dev": { "port": 4000 },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "89ce779c45464717afa3398590d531c5" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "narriflow-dev" }
  ],
  // Admission stays closed until the domain handler registry and acceptance
  // gates integrate. Unknown Workflow subjects fail explicitly.
  "vars": { "ADMISSION_STATE": "closed", "APP_ENV": "development", "TRUSTED_CLIENT_IP_HEADER": "cf-connecting-ip" }
}
