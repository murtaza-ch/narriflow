{
  "name": "@narriflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types/*": {
      "types": "./src/types/*.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@narriflow/auth": "workspace:*",
    "@narriflow/db": "workspace:*",
    "@narriflow/email": "workspace:*",
    "@narriflow/services": "workspace:*",
    "@narriflow/validators": "workspace:*",
    "@prisma/client": "^7.4.2",
    "hono": "^4.12.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.7.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.15.5",
    "pg": "8.16.3"
  }
}
