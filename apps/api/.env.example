# Narriflow API (apps/api). Copy to apps/api/.env for local development; never a root .env.
# Blank values are secrets or per-environment settings. Shared development resources
# (Neon, Upstash, R2) must match apps/worker/.env; run `bun run env:check` before startup.

# --- Core ---
NODE_ENV=development
PORT=4000
# A: where providers, machine clients and MCP reach this API. WEB_ORIGIN: where people are sent.
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Exact browser origins allowed to call first-party routes (no wildcards, never API_ORIGIN).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Full frontend origins accepted in the Clerk session token's azp claim (no wildcard previews).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Pooled connection for runtime. DIRECT_URL belongs to the migration job, not this process.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
API_STREAM_MAX_CONNECTIONS=100
API_STREAM_MAX_CONNECTIONS_PER_ACTOR=5
# Exact Clerk user IDs of platform staff, comma separated. Empty by default.
PLATFORM_STAFF_CLERK_USER_IDS=
# The one header the ingress overwrites with the client address (Railway: x-real-ip). Leave
# unset until verified; unset trusts no forwarded header.
TRUSTED_CLIENT_IP_HEADER=

# --- Clerk ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_OAUTH_ISSUER=
CLERK_OAUTH_CONSENT_ORIGIN=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_CONTINUATION_SECRET=

# --- Storage and events ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
UPSTASH_REDIS_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_BUSINESS_SEAT_MONTHLY=
STRIPE_PRICE_BUSINESS_SEAT_ANNUAL=

# --- Social and Zoom (optional; a missing provider degrades to its typed refusal) ---
# Same encryption key as the worker.
SOCIAL_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public ID, also used to verify Google Drive picker tokens.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
# META_GRAPH_VERSION=
# LINKEDIN_API_VERSION=
# YOUTUBE_API_VERSION=
# YOUTUBE_UPLOAD_CHUNK_BYTES=

# --- Review and email ---
REVIEW_ACCESS_SECRET=
REVIEW_SESSION_SECRET=
RESEND_API_KEY=
NARRIFLOW_EMAIL_FROM=

# --- Analysis and media (optional; a missing provider degrades to its typed refusal) ---
OPENAI_API_KEY=
# OPENAI_CLIP_MODEL=
# OPENAI_CONTENT_MODEL=
# OPENAI_ASSISTED_COPY_MODEL=
# OPENAI_TTS_MODEL=
# OPENAI_IMAGE_MODEL=
# OPENAI_IMAGE_QUALITY=
# ASSISTED_COPY_TIMEOUT_MS=
# GENERATED_IMAGE_MAX_ATTEMPTS=
# GENERATED_IMAGE_MAX_PROMPT_CHARACTERS=
# GENERATED_IMAGE_MAX_OUTPUT_BYTES=
GENERATED_MEDIA_PROMPT_ACTIVE_KEY_VERSION=
GENERATED_MEDIA_PROMPT_ENCRYPTION_KEY=
GENERATED_MEDIA_PROMPT_DECRYPTION_KEYS_JSON=
GENERATED_MEDIA_PROMPT_FINGERPRINT_KEY=
PEXELS_API_KEY=
# PEXELS_SEARCH_CACHE_TTL_SEC=
# EXPORT_BUNDLE_RETENTION_DAYS=
# ASSEMBLYAI_API_KEY is worker-only and not read here.

# --- Upload tuning (optional; validated defaults apply) ---
