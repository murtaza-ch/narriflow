      "Upload": {
        "additionalProperties": false,
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": [
              "string",
              "null",
            ],
          },
          "failureCode": {
            "type": [
              "string",
              "null",
            ],
          },
          "operation": {
            "additionalProperties": false,
            "description": "The upload intake, once finalize accepts it",
            "properties": {
              "kind": {
                "enum": [
                  "intake",
                  "generation",
                  "export",
                ],
                "type": "string",
              },
              "operationId": {
                "type": "string",
              },
              "statusUrl": {
                "format": "uri",
                "type": "string",
              },
            },
            "required": [
              "operationId",
              "kind",
              "statusUrl",
            ],
            "type": [
              "object",
              "null",
            ],
          },
          "projectId": {
            "format": "uuid",
            "type": [
              "string",
              "null",
            ],
          },
          "retryAfterSeconds": {
            "exclusiveMinimum": 0,
            "type": [
              "integer",
              "null",
            ],
          },
          "state": {
            "enum": [
              "uploading",
              "reconciling",
              "queued_for_ingest",
              "terminal",
              "discarded",
              "compensating",
            ],
            "type": "string",
          },
          "transfer": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "headers": {
                    "additionalProperties": {
                      "type": "string",
                    },
                    "type": "object",
                  },
                  "kind": {
                    "enum": [
                      "single",
                    ],
                    "type": "string",
                  },
                  "method": {
                    "enum": [
                      "PUT",
                    ],
                    "type": "string",
                  },
                  "url": {
                    "format": "uri",
                    "type": "string",
                  },
                },
                "required": [
                  "kind",
                  "method",
                  "url",
                  "headers",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "completedParts": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "etag": {
                          "type": "string",
                        },
                        "partNumber": {
                          "type": "integer",
                        },
                      },
                      "required": [
                        "partNumber",
                        "etag",
                      ],
                      "type": "object",
                    },
                    "type": "array",
                  },
                  "concurrency": {
                    "type": "integer",
                  },
                  "grantExpiresAt": {
                    "format": "date-time",
                    "type": "string",
                  },
                  "kind": {
                    "enum": [
                      "multipart",
                    ],
                    "type": "string",
                  },
                  "partCount": {
                    "type": "integer",
                  },
                  "partSizeBytes": {
                    "type": "integer",
                  },
                  "parts": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "partNumber": {
                          "type": "integer",
                        },
                        "url": {
                          "format": "uri",
                          "type": "string",
                        },
                      },
                      "required": [
                        "partNumber",
                        "url",
                      ],
                      "type": "object",
                    },
                    "type": "array",
                  },
                },
                "required": [
                  "kind",
                  "partSizeBytes",
                  "partCount",
                  "concurrency",
                  "parts",
                  "grantExpiresAt",
                  "completedParts",
                ],
                "type": "object",
              },
              {
                "type": "null",
              },
            ],
            "description": "Signed storage URLs. Never log or share them.",
          },
          "uploadId": {
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "uploadId",
          "state",
          "projectId",
          "expiresAt",
          "transfer",
          "retryAfterSeconds",
          "failureCode",
          "operation",
        ],
        "type": "object",
      },
      "UploadResult": {
        "additionalProperties": false,
        "properties": {
          "callback": {
            "$ref": "#/components/schemas/AcceptedCallback",
          },
          "upload": {
            "$ref": "#/components/schemas/Upload",
          },
        },
        "required": [
          "upload",
        ],
        "type": "object",
      },
      "WorkspaceResult": {
        "additionalProperties": false,
        "properties": {
          "usage": {
            "additionalProperties": false,
            "properties": {
              "inFlight": {
                "description": "Videos currently processing",
                "minimum": 0,
                "type": "integer",
              },
              "inFlightLimit": {
                "description": "Videos the plan may process at once",
                "exclusiveMinimum": 0,
                "type": "integer",
              },
              "limitMinutes": {
                "minimum": 0,
                "type": "integer",
              },
              "maxUploadSeconds": {
                "description": "Per-video duration limit",
                "minimum": 0,
                "type": "integer",
              },
              "remainingMinutes": {
                "minimum": 0,
                "type": "integer",
              },
              "reservedMinutes": {
                "description": "Minutes reserved for videos still importing",
                "minimum": 0,
                "type": "integer",
              },
              "tier": {
                "maxLength": 30,
                "type": "string",
              },
              "usedMinutes": {
                "description": "Settled processing minutes this UTC month",
                "minimum": 0,
                "type": "integer",
              },
            },
            "required": [
              "tier",
              "usedMinutes",
              "reservedMinutes",
              "limitMinutes",
              "remainingMinutes",
              "inFlight",
              "inFlightLimit",
              "maxUploadSeconds",
            ],
            "type": "object",
          },
          "workspace": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
              },
              "pricingTier": {
                "type": "string",
              },
              "role": {
                "enum": [
                  "owner",
                  "admin",
                  "editor",
                  "viewer",
                ],
                "type": "string",
              },
              "status": {
                "type": "string",
              },
              "workspaceId": {
                "format": "uuid",
                "type": "string",
              },
            },
            "required": [
              "workspaceId",
              "name",
              "role",
              "status",
              "pricingTier",
            ],
            "type": "object",
          },
        },
        "required": [
          "workspace",
          "usage",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "A Workspace API key (nf_…) from Settings → Developer access",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "description": "Turn long videos into short, captioned clips. Changes within v1 are additive.",
    "title": "Narriflow API",
    "version": "1.0.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/brand-profiles": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrandProfilesResult",
                },
              },
            },
            "description": "Brand Profiles",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid request",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Missing or invalid API key",
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "The Workspace needs active Business access",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Scope, role, or Workspace boundary refusal",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Conflict, including an idempotency key reused with different input",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Unprocessable",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Rate limited; see Retry-After",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Temporarily unavailable; see Retry-After",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "List Brand Profiles",
        "tags": [
          "Workspace",
        ],
      },
    },
    "/api/v1/clips/{id}": {
      "get": {
        "parameters": [
          {
            "description": "Resource ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Resource ID",
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "includeTranscriptExcerpt",
            "required": false,
            "schema": {
              "default": "false",
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClipResult",
                },
              },
            },
            "description": "The clip",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid request",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Missing or invalid API key",
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "The Workspace needs active Business access",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Scope, role, or Workspace boundary refusal",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Conflict, including an idempotency key reused with different input",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Unprocessable",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Rate limited; see Retry-After",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Temporarily unavailable; see Retry-After",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Get a clip",
        "tags": [
          "Clips",
        ],
      },
    },
    "/api/v1/clips/{id}/exports": {
      "post": {
        "description": "Exports the exact editor revision in the selected formats. The response reports any plan limit applied to resolution or watermark.",
        "parameters": [
          {
            "description": "Resource ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Resource ID",
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "description": "1–200 URL-safe characters. Retrying with the same key and input returns the original result; different input under the same key is a conflict.",
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "description": "1–200 URL-safe characters. Retrying with the same key and input returns the original result; different input under the same key is a conflict.",
              "pattern": "^[A-Za-z0-9._~:-]{1,200}$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExportRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
