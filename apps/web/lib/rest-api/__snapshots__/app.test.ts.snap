          },
          "generation": {
            "$ref": "#/components/schemas/GenerationSettings",
          },
          "title": {
            "description": "Defaults to the file name",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "transfer": {
            "default": "auto",
            "description": "single returns one signed PUT at any supported size; auto uses multipart above 100 MiB",
            "enum": [
              "auto",
              "single",
            ],
            "type": "string",
          },
        },
        "required": [
          "file",
        ],
        "type": "object",
      },
      "Operation": {
        "additionalProperties": false,
        "properties": {
          "failureCode": {
