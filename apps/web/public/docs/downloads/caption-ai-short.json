      "name": "Finalize with callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Narriflow API key"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.upload.operation.statusUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "6d38fc54-2721-5e3e-a860-201bce35bc71",
      "name": "Read intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Narriflow API key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The operations this execution waits on. A callback is only a wake-up;\n// Operation Status is the source of truth.\nreturn [{ json: { operationIds: $input.all().map((item) => item.json.operationId) } }];"
      },
      "id": "36bf3831-1891-5094-a170-f887989b6026",
      "name": "Track operations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "1f91cf99-8da3-5882-bccd-5d0a6cbb9be0",
              "leftValue": "={{ $('Read intake').first().json.state !== 'working' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2a87216e-cf56-50c1-b70b-dca75d0cf2a7",
      "name": "Intake finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "limitWait": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 12,
        "resumeUnit": "hours",
        "options": {
          "webhookSuffix": "intake",
          "rawBody": true,
          "binaryPropertyName": "data"
        }
      },
      "id": "40c1f278-9658-505c-a9f9-c5b005113f4b",
      "name": "Wait for intake",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2420,
        500
      ],
      "webhookId": "db6f0fb2-ee14-5056-8e9b-3f23d90398da"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Verify the Standard Webhooks signature, then accept only a new event for an\n// operation this execution is waiting on. Anything else waits again.\nconst crypto = require('crypto');\nlet secret = $vars.NARRIFLOW_CALLBACK_SECRET;\ntry { secret = secret || $env.NARRIFLOW_CALLBACK_SECRET; } catch {}\nif (!secret) throw new Error('Set the NARRIFLOW_CALLBACK_SECRET variable (whsec_…) from Narriflow Settings → API');\nconst key = Buffer.from(secret.replace(/^whsec_/, ''), 'base64');\nconst waiting = new Set($('Track operations').first().json.operationIds);\nconst seen = $getWorkflowStaticData('global');\nseen.narriflowEvents = seen.narriflowEvents || {};\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst id = headers['webhook-id'];\nconst timestamp = Number(headers['webhook-timestamp']);\n// The raw body is binary data; n8n may keep it in filesystem or S3 storage.\nconst raw = item.binary && item.binary.data\n  ? (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8')\n  : JSON.stringify(item.json.body);\nconst expected = crypto.createHmac('sha256', key).update(`${id}.${timestamp}.${raw}`).digest('base64');\nconst offered = String(headers['webhook-signature'] || '').split(' ').map((part) => part.split(',')[1]);\nconst fresh = Math.abs(Date.now() / 1000 - timestamp) < 300;\nconst signed = offered.some((signature) => signature && signature.length === expected.length\n  && crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected)));\nlet event = null;\ntry { event = JSON.parse(raw); } catch {}\nconst accepted = Boolean(signed && fresh && event && event.id === id\n  && waiting.has(event.data.operationId) && !seen.narriflowEvents[id]);\nif (accepted) seen.narriflowEvents[id] = Date.now();\nreturn [{ json: { accepted, eventId: id || null, operationId: event?.data?.operationId ?? null } }];"
      },
      "id": "4d29f233-d939-5064-97b4-7274fd782a45",
      "name": "Verify intake event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        500
      ]
    },
