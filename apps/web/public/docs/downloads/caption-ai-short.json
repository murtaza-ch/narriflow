    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dc56cdf1-4099-5b86-9179-f8d96fd169a4",
              "leftValue": "={{ $json.state !== 'working' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d0d99275-5b4f-5c8c-8624-c75fc2fd9bed",
      "name": "Intake done now?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3300,
        500
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The intake's status follows the whole job: import, captions, framing, and the export.\nconst latest = $input.first().json;\nconst status = latest.state && latest.results ? latest : $('Read intake').first().json;\nif (!['completed', 'partial'].includes(status.state) || !status.results.exportId) {\n  throw new Error(`Narriflow could not caption this video (${status.state}: ${status.failureCode || 'no export'}). Open ${status.reviewUrl} for details.`);\n}\n// notices carries framing_degraded when Center cropped part of the frame.\nreturn [{ json: status }];"
      },
      "id": "51e993ec-2f11-5258-bb56-f9153205b106",
      "name": "Check result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.NARRIFLOW_URL || 'https://api.narriflow.example' }}/api/v1/exports/{{ $json.results.exportId }}/download",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "0178743b-85ee-59df-a532-00311c888062",
      "name": "Download grants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3740,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Narriflow API key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const grants = $input.first().json;\nconst notices = $('Check result').first().json.notices;\nreturn grants.variants.map((variant) => ({ json: { fileName: variant.fileName, aspectRatio: variant.aspectRatio, downloadUrl: variant.downloadUrl, notices } }));"
      },
      "id": "29e68868-8dc4-5e40-8f90-e608a67cdf6e",
      "name": "One item per file",
      "type": "n8n-nodes-base.code",
