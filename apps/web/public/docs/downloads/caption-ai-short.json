      "parameters": {
        "method": "GET",
        "url": "={{ $json.videoUrl }}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "dc4261a9-6c45-54af-a451-7fa29b766fc4",
      "name": "Download AI short",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The idempotency key comes from the execution and the action, so a retried request replays.\nconst item = $input.first();\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst options = $('AI short and options').first().json;\n// captions: auto transcribes the speech, none leaves the video uncaptioned,\n// supplied burns in the SRT or WebVTT text from the srt field.\nconst captions = options.captions === 'supplied' ? { source: 'supplied', text: options.srt } : { source: options.captions || 'auto' };\nreturn [{\n  json: {\n    file: { name: item.binary.data.fileName || 'ai-short.mp4', sizeBytes: buffer.length, contentType: item.binary.data.mimeType || 'video/mp4' },\n    keys: { open: `${$execution.id}:open` },\n    settings: { framing: options.framing || 'fit', aspectRatios: ['9:16'], resolution: '1080p', captions },\n  },\n  binary: item.binary,\n}];"
      },
      "id": "598a9724-ebc7-53a0-b84d-e0a8bf610bce",
      "name": "Prepare upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.NARRIFLOW_URL || 'https://api.narriflow.example' }}/api/v1/captioned-videos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.keys.open }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ...$json.settings, source: { kind: 'upload', file: $json.file, transfer: 'single' } }) }}",
        "options": {}
      },
      "id": "25a4c0ed-c019-5984-8d84-d2f3d1f51141",
      "name": "Open upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Narriflow API key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Carry the downloaded file to the PUT request.\nreturn $input.all().map((item, index) => ({ json: item.json, binary: $('Prepare upload').all()[index].binary }));"
      },
      "id": "3c174693-495c-5fa3-96f8-394712d94e53",
      "name": "Attach file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.upload.transfer.url }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "={{ $json.upload.transfer.headers['Content-Type'] }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data"
      },
      "id": "54ceb7bf-3540-5a65-b729-79416cef4cc6",
      "name": "PUT file to storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.NARRIFLOW_URL || 'https://api.narriflow.example' }}/api/v1/uploads/{{ $('Open upload').item.json.upload.uploadId }}/finalize",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ callback: { url: $execution.resumeUrl + '/intake' } }) }}",
        "options": {}
