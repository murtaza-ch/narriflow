# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared dev database. Copy pooled/direct URLs from Railway dev; see the environment runbook.
DATABASE_URL=
DIRECT_URL=

# Auth
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/?auth=sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/?auth=sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue
# Remote MCP / Clerk OAuth resource server
# Use the Clerk Frontend API issuer, e.g. https://clerk.app.example.com.
CLERK_OAUTH_ISSUER=
# Optional Clerk Account Portal origin used for the hosted OAuth consent screen.
CLERK_OAUTH_CONSENT_ORIGIN=
# Optional comma-separated hostname/origin additions for preview or browser clients.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
STRIPE_PRICE_CREATOR_MONTHLY=price_...
STRIPE_PRICE_CREATOR_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_SEAT_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_SEAT_ANNUAL=price_...

# Storage / Events
# Upstash is required for live workflow updates when web and worker run separately.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narriflow-dev
# Configure the bucket to abort incomplete multipart uploads after seven days.
R2_INCOMPLETE_MULTIPART_LIFECYCLE_DAYS=7

# Free-project retention (72 hours) and the paid-access-ended grace (28 days)
# come from the plan catalog in packages/validators/src/pricing.ts; no settings.

# AI
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Use the same four prompt-protection values in web and worker. Generate the
# encryption and fingerprint keys independently with: openssl rand -base64 32
GENERATED_MEDIA_PROMPT_ACTIVE_KEY_VERSION=production-v1
GENERATED_MEDIA_PROMPT_ENCRYPTION_KEY=
GENERATED_MEDIA_PROMPT_DECRYPTION_KEYS_JSON={}
GENERATED_MEDIA_PROMPT_FINGERPRINT_KEY=
GENERATED_IMAGE_MAX_ATTEMPTS=4
GENERATED_IMAGE_MAX_PROMPT_CHARACTERS=4000
GENERATED_IMAGE_MAX_OUTPUT_BYTES=20971520
ASSEMBLYAI_API_KEY=

# Native social OAuth
# Generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v24.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202608
X_CLIENT_ID=
X_CLIENT_SECRET=

# Upload page cloud pickers. Each button appears only when its values are set.
# Google Drive needs all three, and SOCIAL_TOKEN_ENCRYPTION_KEY in web and worker.
# See docs/runbooks/cloud-file-pickers.md.
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_APP_ID=
NEXT_PUBLIC_DROPBOX_APP_KEY=

# Workflows
INGEST_POLL_INTERVAL_MS=2500
EXPORT_BUNDLE_RETENTION_DAYS=7

# Email
REVIEW_ACCESS_SECRET=
RESEND_API_KEY=
NARRIFLOW_EMAIL_FROM="Narriflow <no-reply@narriflow.app>"

# Observability
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Zoom cloud recordings. Set the same values on web and worker.
# See docs/runbooks/zoom-autopilot.md. Tokens use SOCIAL_TOKEN_ENCRYPTION_KEY.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
