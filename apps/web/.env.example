# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/narriflow

# Auth
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage / Events
# Upstash is required for live workflow updates when web and worker run separately.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI
# Worker-only for the current transcription milestone, but commonly shared in one secrets store.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Workflows
# Reserved for future Trigger.dev work. The current custom worker polling flow does not use it.
TRIGGER_SECRET_KEY=
INGEST_POLL_INTERVAL_MS=2500

# Email
RESEND_API_KEY=
NARRIFLOW_EMAIL_FROM="Narriflow <no-reply@narriflow.app>"

# Observability
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
