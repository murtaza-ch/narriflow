# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Collaboration rollout. Enable globally, or leave false and list selected
# application User.id values in WORKSPACES_V1_USER_IDS.
WORKSPACES_V1=false
WORKSPACES_V1_USER_IDS=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/narriflow

# Auth
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Remote MCP / Clerk OAuth resource server
# Use the Clerk Frontend API issuer, e.g. https://clerk.app.example.com.
CLERK_OAUTH_ISSUER=
# Optional Clerk Account Portal origin used for the hosted OAuth consent screen.
CLERK_OAUTH_CONSENT_ORIGIN=
# Optional comma-separated hostname/origin additions for preview or browser clients.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=price_...
STRIPE_PRICE_CREATOR_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_SEAT_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_SEAT_ANNUAL=price_...

# Storage / Events
# Upstash is required for live workflow updates when web and worker run separately.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Free-project retention. Keep both web and worker in observe mode for at
# least seven days. Enforcement is fail-closed unless an explicit UTC
# activation timestamp is present; projects created before it are grandfathered.
PROJECT_RETENTION_MODE=observe
# PROJECT_RETENTION_OBSERVE_STARTED_AT=2026-08-13T00:00:00.000Z
# PROJECT_RETENTION_ENFORCEMENT_STARTED_AT=2026-08-20T00:00:00.000Z

# AI
# Worker-only for generation, but commonly shared in one secrets store.
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=

# Native social OAuth
# Generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v20.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Workflows
# Reserved for future Trigger.dev work. The current custom worker polling flow does not use it.
TRIGGER_SECRET_KEY=
INGEST_POLL_INTERVAL_MS=2500

# Email
RESEND_API_KEY=
NARRIFLOW_EMAIL_FROM="Narriflow <no-reply@narriflow.app>"

# Observability
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Versioned Clip Composition Plan preview controls: legacy, shadow, or plan.
# Defaults to shadow when omitted. Keep each value aligned with the
# corresponding worker control before cutover.
# NEXT_PUBLIC_COMPOSITION_CENTER=plan
# NEXT_PUBLIC_COMPOSITION_FIT=plan
# NEXT_PUBLIC_COMPOSITION_AUTO=plan
