# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Collaboration rollout. Enable globally, or leave false and list selected
# application User.id values in WORKSPACES_V1_USER_IDS.
WORKSPACES_V1=false
WORKSPACES_V1_USER_IDS=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/narriflow

# Auth
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# Separate 32+ character keys. REVIEW_ACCESS_SECRET derives opaque links from
# round IDs; REVIEW_SESSION_SECRET signs sessions and encrypts reviewer email.
REVIEW_ACCESS_SECRET=
REVIEW_SESSION_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Remote MCP / Clerk OAuth resource server
# Use the Clerk Frontend API issuer, e.g. https://clerk.app.example.com.
CLERK_OAUTH_ISSUER=
# Optional Clerk Account Portal origin used for the hosted OAuth consent screen.
CLERK_OAUTH_CONSENT_ORIGIN=
# Optional comma-separated hostname/origin additions for preview or browser clients.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=price_...
STRIPE_PRICE_CREATOR_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_SEAT_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_SEAT_ANNUAL=price_...

# Storage / Events
# Upstash is required for live workflow updates when web and worker run separately.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Configure the bucket to abort incomplete multipart uploads after seven days.
R2_INCOMPLETE_MULTIPART_LIFECYCLE_DAYS=7

# Vizard-inspired expansion rollout controls. Writes remain disabled unless a
# release group is explicitly set to 1; existing data stays readable.
# NARRIFLOW_WRITES_BRAND_PROFILES=1
# NARRIFLOW_WRITES_VISUAL_ASSETS=1
# NARRIFLOW_WRITES_BRAND_FONTS=1
# NARRIFLOW_WRITES_BRAND_KIT_PROJECTION=1
# NARRIFLOW_WRITES_CAMPAIGN_OPERATIONS=1
# Campaign actions are an ordered chain. A later 1 remains closed until every
# preceding stage is also 1.
NARRIFLOW_WRITES_CAMPAIGN_RENDER=0
NARRIFLOW_WRITES_CAMPAIGN_EXPORTS=0
NARRIFLOW_WRITES_CAMPAIGN_CREATIVE=0
NARRIFLOW_WRITES_CAMPAIGN_DELIVERY=0
# Auto Censor opens scan preview before each persistent treatment.
NARRIFLOW_WRITES_CENSOR_SCAN=0
NARRIFLOW_WRITES_CENSOR_CAPTION_MASK=0
NARRIFLOW_WRITES_CENSOR_MUTE=0
NARRIFLOW_WRITES_CENSOR_BEEP=0
# Motion opens in preview/export parity order. Zoom is intentionally isolated
# between directional transitions and media animation.
NARRIFLOW_MOTION_SHADOW_LEGACY_TRANSITIONS=0
NARRIFLOW_WRITES_MOTION_CROSS_DISSOLVE=0
NARRIFLOW_WRITES_MOTION_DIRECTIONAL_WIPE=0
NARRIFLOW_WRITES_MOTION_DIRECTIONAL_SLIDE=0
NARRIFLOW_WRITES_MOTION_ZOOM=0
NARRIFLOW_WRITES_MOTION_MEDIA_FADE_SCALE=0
NARRIFLOW_WRITES_MOTION_PAN_KEN_BURNS=0
NARRIFLOW_WRITES_MOTION_CAMPAIGN_APPLY=0
# Review creation, guest access, feedback mutations, and email admission are
# independent. A paused guest read is a generic temporary denial; it does not
# revoke or rewrite the existing round or session.
# NARRIFLOW_WRITES_REVIEW_ROOMS=1
# NARRIFLOW_READS_REVIEW_GUEST=1
# NARRIFLOW_WRITES_REVIEW_FEEDBACK=1
# Set the same notification value in the worker deployment.
# NARRIFLOW_WRITES_REVIEW_NOTIFICATIONS=1
# Approval defaults to global enforcement. Use warn for a measured dark launch,
# or keep enforce and list cohort UUIDs to enforce only those workspaces/projects.
# NARRIFLOW_REVIEW_APPROVAL_MODE=enforce
# NARRIFLOW_REVIEW_APPROVAL_ENFORCE_WORKSPACE_IDS=
# NARRIFLOW_REVIEW_APPROVAL_ENFORCE_PROJECT_IDS=
# NARRIFLOW_WRITES_SCENE_CARDS=1
# NARRIFLOW_WRITES_SCENE_IMAGES=1
# NARRIFLOW_WRITES_SCENE_VIDEOS=1
# NARRIFLOW_WRITES_SCENE_TEMPLATES=1
# NARRIFLOW_WRITES_GENERATED_MEDIA=1
# NARRIFLOW_WRITES_GENERATED_IMAGES=1
# Short video remains off until an approved provider adapter passes release gates.
NARRIFLOW_WRITES_GENERATED_VIDEOS=0
# NARRIFLOW_WRITES_ASSISTED_COPY=1
# NARRIFLOW_WRITES_THUMBNAIL_EXTRACTION=1
# NARRIFLOW_WRITES_BULK_SCHEDULING=1

# Free-project retention. Keep both web and worker in observe mode for at
# least seven days. Enforcement is fail-closed unless an explicit UTC
# activation timestamp is present; projects created before it are grandfathered.
PROJECT_RETENTION_MODE=observe
# PROJECT_RETENTION_OBSERVE_STARTED_AT=2026-08-13T00:00:00.000Z
# PROJECT_RETENTION_ENFORCEMENT_STARTED_AT=2026-08-20T00:00:00.000Z

# AI
# Assisted-copy generation and generated-media admission execute in the web app.
OPENAI_API_KEY=
# Deployment-selected alias; assisted copy fails closed when unset.
OPENAI_COPY_MODEL=
OPENAI_IMAGE_MODEL=
# Independent 32+ character values; never reuse one key for both purposes.
GENERATED_MEDIA_PROMPT_ACTIVE_KEY_VERSION=primary-v1
GENERATED_MEDIA_PROMPT_ENCRYPTION_KEY=
# Optional JSON object of prior key versions retained only for decrypting queued work.
GENERATED_MEDIA_PROMPT_DECRYPTION_KEYS_JSON={}
# Keep stable across encryption-key rotations so idempotent replay fingerprints remain valid.
GENERATED_MEDIA_PROMPT_FINGERPRINT_KEY=
GENERATED_IMAGE_MAX_CONCURRENCY=2
GENERATED_IMAGE_USAGE_UNITS=1
GENERATED_IMAGE_DAILY_USAGE_LIMIT=20
# Counts every admitted attempt, including reservations later released.
GENERATED_IMAGE_DAILY_ABUSE_LIMIT=40
# Keep these aligned with the worker when generated video is released.
# GENERATED_VIDEO_DAILY_USAGE_LIMIT=60
# GENERATED_VIDEO_DAILY_ABUSE_LIMIT=120
ASSEMBLYAI_API_KEY=

# Native social OAuth
# Generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v20.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Workflows
# Reserved for future Trigger.dev work. The current custom worker polling flow does not use it.
TRIGGER_SECRET_KEY=
INGEST_POLL_INTERVAL_MS=2500
EXPORT_BUNDLE_RETENTION_DAYS=7

# Email
RESEND_API_KEY=
NARRIFLOW_EMAIL_FROM="Narriflow <no-reply@narriflow.app>"

# Observability
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Clip Composition Plan is the only preview path. These public values mirror
# worker analysis capabilities so Studio can show honest fallback messaging.
# NEXT_PUBLIC_AUTOMATIC_SPEAKER_LAYOUT=1
# Mirror the Split and Screen analysis kill switches (0 or 1).
# NEXT_PUBLIC_SPLIT_LAYOUT=1
# NEXT_PUBLIC_SCREEN_LAYOUT=1
