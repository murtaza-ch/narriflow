# The web app is a client of the API (apps/api). It holds no database, storage,
# billing, AI or provider credentials: those belong to apps/api and apps/worker.
# Copy to apps/web/.env.local. Run `bun run env:check` before startup.

# Runtime
NODE_ENV=development
# W: this app's own public origin (docs absolute links, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# A: the API origin the browser calls directly. Read at BUILD time (CSP connect-src,
# docs examples) and at runtime. Must equal API_ORIGIN in apps/api/.env.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth (the same Clerk instance as apps/api)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Used only by proxy.ts to redirect unsigned page navigations.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/?auth=sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/?auth=sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue

# Upload page cloud pickers. Each button appears only when its values are set.
# Google Drive needs all three (the client ID also goes in apps/api/.env).
# See docs/runbooks/cloud-file-pickers.md.
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_APP_ID=
NEXT_PUBLIC_DROPBOX_APP_KEY=
