{
  "extends": "../../packages/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@narriflow/caption-fonts/emoji": ["../../packages/caption-fonts/src/emoji.ts"],
      "@narriflow/caption-fonts/glyph-coverage": ["../../packages/caption-fonts/src/glyph-coverage.ts"],
      "@narriflow/caption-fonts/emoji/atlas.png": ["../../packages/caption-fonts/emoji/atlas.png"],
      "@narriflow/api-client": ["../../packages/api-client/src/index.ts"],
      "@narriflow/api-client/*": ["../../packages/api-client/src/*"],
      "@narriflow/ui": ["../../packages/ui/src/index.ts"],
      "@narriflow/ui/*": ["../../packages/ui/src/*"],
      "@narriflow/validators": ["../../packages/validators/src/index.ts"],
      "@narriflow/validators/*": ["../../packages/validators/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.db.fixture.ts",
    "**/*.contract.fixture.ts",
    "**/*.browser.fixture.tsx",
    "**/*.focus.fixture.tsx",
    "scripts"
  ]
}
