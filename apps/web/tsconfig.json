{
  "extends": "../../packages/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@narriflow/auth": ["../../packages/auth/src/index.ts"],
      "@narriflow/auth/*": ["../../packages/auth/src/*"],
      "@narriflow/db": ["../../packages/db/src/index.ts"],
      "@narriflow/db/*": ["../../packages/db/src/*"],
      "@narriflow/email": ["../../packages/email/src/index.ts"],
      "@narriflow/email/*": ["../../packages/email/src/*"],
      "@narriflow/services": ["../../packages/services/src/index.ts"],
      "@narriflow/services/*": ["../../packages/services/src/*"],
      "@narriflow/ui": ["../../packages/ui/src/index.ts"],
      "@narriflow/ui/*": ["../../packages/ui/src/*"],
      "@narriflow/validators": ["../../packages/validators/src/index.ts"],
      "@narriflow/validators/*": ["../../packages/validators/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.focus.fixture.tsx",
    "scripts"
  ]
}
