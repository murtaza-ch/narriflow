/// Tracked Video: one directly published video whose public counts are read
/// back from its platform on a fixed schedule. It belongs to the Workspace,
/// not the Project, so deleting a Project or purging it by retention only
/// detaches `socialPostId`; the captures and the clip facts stay. `clipFacts`
/// is frozen once, at the first successful capture, and never rewritten.
model TrackedVideo {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @db.Uuid
  socialAccountId String?        @db.Uuid
  socialPostId    String?        @db.Uuid
  platform        SocialPlatform
  platformPostId  String
  publishedAt     DateTime
  /// The clip this video is of, frozen when it is first tracked. No foreign key:
  /// it only tells videos of one clip apart (a clip posted to several platforms)
  /// after the clip or its Project is gone.
  clipId          String?        @db.Uuid
  clipFacts       Json?
  clipFactsAt     DateTime?
  createdAt       DateTime       @default(now())

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  socialPost    SocialPost?          @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  captures      PerformanceCapture[]

  @@unique([workspaceId, platform, platformPostId])
  @@index([workspaceId, publishedAt])
  @@index([socialPostId])
}

/// Performance Capture: one scheduled read of a Tracked Video's public counts.
/// A row is created per slot when the video is first tracked, claimed by a
/// worker lease when due, and settled once as captured or skipped. A count the
/// platform doesn't report stays null. `raw` keeps the provider's metrics and
/// `apiVersion` the API that produced them.
model PerformanceCapture {
  id               String                  @id @default(uuid()) @db.Uuid
  trackedVideoId   String                  @db.Uuid
  slot             Int
  dueAt            DateTime
  state            PerformanceCaptureState @default(scheduled)
  attempts         Int                     @default(0)
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  skipReason       String?
  capturedAt       DateTime?
  apiVersion       String?
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  watchTimeSeconds Int?
  raw              Json?
  createdAt        DateTime                @default(now())

  trackedVideo TrackedVideo @relation(fields: [trackedVideoId], references: [id], onDelete: Cascade)

  @@unique([trackedVideoId, slot])
  @@index([state, dueAt])
}

/// Performance Guidance: what tends to work for one Workspace's audience, from
/// its recent Tracked Videos' frozen clip facts and 7-day counts, normalised per
/// platform. Recomputed about nightly. `platforms` and `groups` follow
/// `performanceGuidanceSchema`; `groups` is empty until the Workspace has
/// enough clips. `attemptedAt` is the last try, successful or not, so a
/// Workspace that keeps failing waits a day like any other instead of holding up
/// the rest; `computedAt` is when `groups` was actually computed.
model PerformanceGuidance {
  workspaceId String   @id @db.Uuid
  computedAt  DateTime
  attemptedAt DateTime
  totalPosts  Int
  platforms   Json
  groups      Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ProjectAnalyticsEvent {
  id        String             @id @default(uuid()) @db.Uuid
  projectId String             @db.Uuid
  clipId    String?            @db.Uuid
  type      AnalyticsEventType
  platform  SocialPlatform?
  metadata  Json?
  createdAt DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clip    Clip?   @relation(fields: [clipId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([clipId, type])
  @@index([type, createdAt])
}

model ProgramAnalyticsEvent {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @db.Uuid
  actorUserId String             @db.Uuid
  projectId   String?            @db.Uuid
  type        AnalyticsEventType
  metadata    Json
  createdAt   DateTime           @default(now())

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([type, createdAt])
}

model PublishedSocialVideo {
  id             String     @id @default(uuid()) @db.Uuid
  socialPostId   String     @db.Uuid
  platformPostId String
  externalUrl    String?
  publishedAt    DateTime   @default(now())
  socialPost     SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@unique([socialPostId, platformPostId])
  @@index([publishedAt])
}

/// Operation Receipt: the durable acceptance record of one idempotent
/// mutation, keyed by Workspace, acting user, canonical command, and the
/// client's idempotency key. Domain work remains owned by the referenced
/// Project, Workflow Run, Clip Export, rule, or Social Post.
model OperationReceipt {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @db.Uuid
  actorUserId          String   @db.Uuid
  command              String
  clientIdempotencyKey String
  fingerprint          String
  resourceType         String
  resourceId           String
  result               Json
  createdAt            DateTime @default(now())

  @@unique([workspaceId, actorUserId, command, clientIdempotencyKey], map: "OperationReceipt_identity_key")
  @@index([resourceType, resourceId])
  @@index([workspaceId, createdAt])
}

/// Completion Callback: a signed, at-least-once notification delivered to a
/// caller-supplied URL when one accepted operation reaches a terminal
/// Operation Status. Exactly one of `receiptId` (link intake, generation,
/// export) and `uploadSessionId` (upload intake) is set. There is no foreign
/// key to Project, so deleting a Project can't drop a pending delivery.
model CompletionCallback {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  operationKind      String
  operationId        String    @db.Uuid
  receiptId          String?   @unique @db.Uuid
  uploadSessionId    String?   @unique @db.Uuid
  /// AES-256-GCM sealed URL; logs and errors carry only `urlHost`.
  encryptedUrl       String
  urlHost            String
  urlFingerprint     String
  eventId            String    @unique @db.Uuid
  /// waiting | pending | delivered | failed | cancelled
  state              String    @default("waiting")
  observationCount   Int       @default(0)
  nextObservationAt  DateTime  @default(now())
  attempts           Int       @default(0)
  nextAttemptAt      DateTime?
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  /// Frozen once the operation is terminal; redelivery resends it unchanged.
  payload            Json?
  lastResponseStatus Int?
  deliveredAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([state, nextObservationAt])
  @@index([state, nextAttemptAt])
  @@index([workspaceId, operationKind, operationId])
}

/// A Workspace's Completion Callback signing secret. The current secret has no
/// `retiresAt`; after rotation the previous one keeps signing until it retires.
model CallbackSigningSecret {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  encryptedSecret String
  createdAt       DateTime  @default(now())
  retiresAt       DateTime?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, retiresAt])
}

/// Workspace Event: an append-only, Workspace-scoped, versioned record of one
/// finished transition, polled with `seq` as the cursor. `subject` carries IDs
/// only. There is no foreign key to Project, so events outlive their Project;
/// a maintenance loop deletes rows after 30 days.
model WorkspaceEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  seq         BigInt
  type        String
  version     Int       @default(1)
  subject     Json
  occurredAt  DateTime
  createdAt   DateTime  @default(now())
  /// One transition never emits twice.
  dedupeKey   String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, seq])
  @@index([createdAt])
}

/// The durable memory that a transition already has its Workspace Event. The
/// 30-day purge deletes events but never keys, so a later settlement of the
/// same lineage can't emit it again. Keys go with their Project, or with the
/// Workspace when the transition ended before any Project existed.
model WorkspaceEventKey {
  dedupeKey   String    @id
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
}

/// The per-Workspace sequence behind `WorkspaceEvent.seq`. A writing
/// transaction increments it as its last write, and the row lock holds until
/// commit, so commit order matches `seq` order. It lives here, not on
/// `Workspace`, whose row existing `FOR UPDATE` locks already contend for.
model WorkspaceEventCounter {
  workspaceId String    @id @db.Uuid
  lastSeq     BigInt    @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Webhook Subscription: a Workspace's HTTPS endpoint that receives its
/// Workspace Events as signed POSTs, in `seq` order, at least once. The URL is
/// sealed like a Completion Callback URL; logs and errors carry only `urlHost`.
/// `lastDeliveredSeq` is the cursor: every matching event up to it has been
/// acknowledged with a 2xx, and it moves only on success. A worker loop claims
/// the row with a lease. It is disabled with a reason after 20 consecutive
/// failures, a 410, or when the cursor falls behind event retention.
model WebhookSubscription {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @db.Uuid
  createdByUserId     String?   @db.Uuid
  encryptedUrl        String
  urlHost             String
  urlFingerprint      String
  /// Workspace Event types to deliver; never empty.
  types               String[]
  /// active | disabled
  status              String    @default("active")
  lastDeliveredSeq    BigInt
  consecutiveFailures Int       @default(0)
  nextAttemptAt       DateTime  @default(now())
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  lastAttemptAt       DateTime?
  lastResponseStatus  Int?
  lastDeliveredAt     DateTime?
  /// consecutive_failures | cursor_expired | endpoint_gone
  disabledReason      String?
  disabledAt          DateTime?
  /// Set when the creator's email was attempted; a skipped send clears it.
  disabledNotifiedAt  DateTime?
  /// Set by re-enabling: the next drain moves the cursor past events that
  /// expired while the subscription was disabled, then clears it.
  skipExpiredOnResume Boolean   @default(false)
  /// Throttles `POST /webhooks/{id}/test`.
  lastTestedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User?     @relation("WebhookSubscriptionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, urlFingerprint])
  @@index([status, nextAttemptAt])
  @@index([createdByUserId])
}

/// What happens after one generation completes, asked for by an Autopilot rule
/// or inline on a request: export the best clips, write assisted copy, then
/// leave the Project ready to review. One row per generation, keyed by its
/// origin (speech-to-text) run and created in the transaction that admits it,
/// so retries and replays find the same row. The generation's settlement moves
/// `waiting` to `due` or `skipped` in its own transaction; a worker loop claims
/// `due` rows with a lease and ends them `ready`, `partial` or `skipped`.
/// `picks` remembers the chosen clips and what each one produced, so a
/// re-claim resumes where the last attempt stopped instead of starting over.
model GenerationFinishing {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @db.Uuid
  projectId      String    @db.Uuid
  originRunId    String    @unique @db.Uuid
  /// The person the work runs as. No foreign key: a missing member skips it.
  actorUserId    String?   @db.Uuid
  /// FrozenFinishingSettings, resolved at admission.
  settings       Json
  /// The Autopilot rule whose import froze this row, from its Content Pack. Null for
  /// finishing asked for inline by a request. Standing Grants cover only these rows.
  autopilotRuleId String?   @db.Uuid
  /// waiting | due | running | exporting | ready | partial | skipped
  state          String    @default("waiting")
  reason         String?
  picks          Json?
  /// Unexpected failures; waiting for exports is not an attempt.
  attempts       Int       @default(0)
  dueAt          DateTime?
  nextAttemptAt  DateTime?
  claimToken     String?   @db.Uuid
  leaseExpiresAt DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originRun WorkflowRun @relation(fields: [originRunId], references: [id], onDelete: Cascade)
  reviewRound ReviewRound?

  @@index([state, nextAttemptAt, leaseExpiresAt])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([workspaceId])
}

/// Authority a Workspace Owner or Admin gave one Autopilot rule's output to go out
/// without a click: its proposals accepted into a Social Account's queue
/// (`publish`), or its finished exports sent as a Review Round to named reviewers
/// (`review_send`). Caps count acceptances or rounds in the last 24 hours and
/// 7 days; the grant ends at `expiresAt`. `revision` rises on each renewal, and
/// what a grant sent records the revision it went out under.
model StandingGrant {
  id                 String              @id @default(uuid()) @db.Uuid
  workspaceId        String              @db.Uuid
  kind               StandingGrantKind
  /// Null once the rule is deleted; the grant is revoked then and kept as the audit trail.
  autopilotRuleId    String?             @db.Uuid
  /// publish only; never a TikTok account.
  socialAccountId    String?             @db.Uuid
  /// review_send only: normalized email addresses.
  reviewerEmails     Json?
  dailyCap           Int
  weeklyCap          Int
  expiresAt          DateTime
  status             StandingGrantStatus @default(active)
  pausedReason       String?
  /// A pause the system made is emailed to the granter once.
  pauseNoticePending Boolean             @default(false)
  /// A worker holds the notice until this time; the notice stays pending until it is sent.
  pauseNoticeLeaseUntil DateTime?
  /// Hash of the rule's content-bearing fields and its Brand Profile's approval rule when
  /// the grant was made or renewed. A rule that no longer matches pauses the grant.
  ruleFingerprint    String
  revision           Int                 @default(1)
  grantedByUserId    String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  autopilotRule AutopilotRule?       @relation(fields: [autopilotRuleId], references: [id], onDelete: SetNull)
  socialAccount SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  grantedBy     User?                @relation("StandingGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  events        StandingGrantEvent[]
  socialPosts   SocialPost[]
  reviewRounds  ReviewRound[]

  @@index([workspaceId, status])
  @@index([autopilotRuleId, status])
  @@index([status, expiresAt])
  @@index([pauseNoticePending])
}

/// The grant's audit trail: created, renewed, paused, revoked, expired.
model StandingGrantEvent {
  id          String   @id @default(uuid()) @db.Uuid
  grantId     String   @db.Uuid
  kind        String
  revision    Int
  /// Null when the system acted.
  actorUserId String?  @db.Uuid
  reason      String?
  createdAt   DateTime @default(now())

  grant StandingGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId, createdAt])
}

/// A reviewer who asked, from a grant-sent review email, to stop automated review
/// requests from one Workspace. Grants skip them; a person can still invite them.
model ReviewerOptOut {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  email       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

/// Request-owned handle for existing work. Expiry never changes domain work.
model McpTask {
  id                      String    @id @default(uuid()) @db.Uuid
  ownerUserId             String    @db.Uuid
  callerId                String
  workspaceId             String    @db.Uuid
  toolName                String
  domainKind              String
  domainId                String    @db.Uuid
  projectId               String    @db.Uuid
  clipId                  String?   @db.Uuid
  originatingOperationId  String
  resultContract          Json
  initialResult           Json
  status                  String    @default("working")
  terminalOutcome         Json?
  cancellationRequestedAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  expiresAt               DateTime

  @@unique([ownerUserId, callerId, toolName, domainKind, domainId])
  @@index([expiresAt])
  @@index([workspaceId, ownerUserId])
}
