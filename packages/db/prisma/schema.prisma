model Project {
  id                       String                    @id @default(uuid()) @db.Uuid
  title                    String
  sourceMediaUrl           String
  sourceType               SourceType                @default(upload)
  sourceProvider           String?
  sourceInput              String?
  sourceStorageKey         String?
  sourceMimeType           String?
  sourceSizeBytes          BigInt?
  sourceDurationSeconds    Int?
  /// Measured at ingest: frame rate, dimensions, and audio. See sourceProbeSchema.
  sourceProbe              Json?
  languageCode             String?
  ingestStatus             IngestStatus              @default(pending)
  ingestErrorCode          String?
  ingestCompletedAt        DateTime?
  workspaceId              String                    @db.Uuid
  createdByUserId          String?                   @db.Uuid
  updatedByUserId          String?                   @db.Uuid
  folderId                 String?                   @db.Uuid
  brandTemplateId          String?                   @db.Uuid
  brandSnapshot            Json?
  brandProfileId           String?                   @db.Uuid
  brandProfileSnapshot     Json?
  censorTerms              Json                      @default("[]")
  // Client-minted commit token: concurrent Step-1 double-submits collapse in
  // the database, not the UI.
  commitToken              String?                   @unique @db.Uuid
  notifyOnComplete         Boolean                   @default(true)
  retentionPolicyKey       String?
  expiresAt                DateTime?
  purgeStartedAt           DateTime?
  purgeLeaseExpiresAt      DateTime?
  purgeRetryAt             DateTime?
  purgeAttemptCount        Int                       @default(0)
  purgeDeletedObjectCount  Int                       @default(0)
  purgeDeletedBytes        BigInt                    @default(0)
  purgeStorageVerifiedAt   DateTime?
  purgeLastError           String?
  /// Monotonic allocator for WorkflowEvent.seq. Updated in the same
  /// transaction as lifecycle transitions and event insertion.
  workflowEventSeq         Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  contentPacks             ContentPack[]
  ingestJobs               IngestJob[]
  transcript               Transcript?
  transcriptPassages       TranscriptPassage[]
  clips                    Clip[]
  createdBy                User?                     @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder                   WorkspaceFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  brandTemplate            BrandTemplate?            @relation(fields: [brandTemplateId], references: [id], onDelete: SetNull)
  brandProfile             BrandProfile?             @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  workflowRuns             WorkflowRun[]
  workflowEvents           WorkflowEvent[]
  contentAssets            ContentAsset[]
  socialPosts              SocialPost[]
  workspaceEventKeys       WorkspaceEventKey[]
  generationFinishings     GenerationFinishing[]
  analyticsEvents          ProjectAnalyticsEvent[]
  generatedMediaJobs       GeneratedMediaJob[]
  assistedCopyGenerations  AssistedCopyGeneration[]
  thumbnailFrameOperations ThumbnailFrameOperation[]
  clipDubs                 ClipDub[]
  autopilotEpisodes        AutopilotEpisode[]
  notificationLedgers      NotificationLedger[]
  clipExports              ClipExport[]
  campaignOperations       CampaignOperation[]
  reviewRounds             ReviewRound[]
  reviewApprovalOverrides  ReviewApprovalOverride[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, ingestStatus, createdAt])
  @@index([workspaceId, folderId, createdAt])
  @@index([brandTemplateId])
  @@index([brandProfileId])
  @@index([expiresAt, purgeRetryAt, purgeLeaseExpiresAt])
}

/// Content-free proof that an expired project was removed. This deliberately
/// has no Project foreign key so the receipt survives the project's hard
/// delete and can fence point-in-time restores for 90 days.
model ProjectDeletionReceipt {
  id                  String   @id @default(uuid()) @db.Uuid
  projectIdHash       String   @unique
  retentionPolicyKey  String
  expiresAt           DateTime
  purgeCompletedAt    DateTime
  objectCount         Int
  totalBytes          BigInt
  tombstoneStorageKey String
  deleteAfter         DateTime
  createdAt           DateTime @default(now())

  @@index([deleteAfter])
}

/// Repurposed text outputs generated from the transcript (blog, thread,
/// LinkedIn post, show notes, quote cards). One row per (project, type).
model ContentAsset {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  type      OutputType
  title     String
  body      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId, createdAt])
}

model ContentPack {
  id                      String       @id @default(uuid()) @db.Uuid
  projectId               String       @db.Uuid
  outputTypes             OutputType[]
  clipGenerationMode      String       @default("best")
  clipCountTarget         Int
  clipDurationSecTarget   Int
  minDurationSec          Int          @default(15)
  preferredMinDurationSec Int          @default(30)
  preferredMaxDurationSec Int          @default(60)
  maxDurationSec          Int          @default(90)
  platformTargets         String[]     @default(["tiktok", "youtube_shorts", "instagram_reels"])
  toneConstraints         Json
  captionPreset           String
  platformPlaybookVersion String
  mode                    String       @default("clip")
  autoHook                Boolean      @default(true)
  specificMoments         String       @default("")
  processingStartSec      Int?
  processingEndSec        Int?
  // Link-first split: Step 1 (Commit) writes a draft; Step 2 (Configure)
  // flips it to committed. A draft must never start generation — every
  // reader takes the latest pack overall and STOPS if it is a draft
  // (filtering drafts out first could silently run an older committed pack).
  // At most one draft per project (partial unique index in the migration —
  // Prisma cannot express it here).
  draft                   Boolean      @default(false)
  clipLengthPreset        String       @default("auto")
  defaultAspectRatio      String       @default("9:16")
  /// Set only by the Autopilot import, from the rule that imported the Project.
  /// A generation's finishing copies it, and Standing Grants cover finishing by it.
  autopilotRuleId         String?      @db.Uuid
  /// Captioned-video settings (framing, caption source with normalized
  /// supplied utterances, export formats), validated by
  /// captionedVideoSettingsSchema. Requires mode "caption_only".
  captionedVideo          Json?
  /// Finishing settings the request carried; the handoff freezes them onto a
  /// GenerationFinishing row. Null means no finishing.
  finishing               Json?
  /// The Recipe ({ id, revision }) this generation's settings were read from,
  /// kept for audit. Null when the settings were sent explicitly.
  recipe                  Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRuns WorkflowRun[]
}

model WorkflowRun {
  id                    String    @id @default(uuid()) @db.Uuid
  projectId             String    @db.Uuid
  idempotencyKey        String
  stage                 String
  status                String
  progress              Int       @default(0)
  errorCode             String?
  // Incremented on each claim. IngestJob has had this field all along but
  // nothing ever read it, so one transient socket error killed a job
  // permanently; WorkflowRun had no equivalent at all, so stt /
  // moment_detection / clip_rendering / dubbing could not be retried either.
  attemptCount          Int       @default(0)
  /// Immutable identity for the current execution attempt. It remains set
  /// while an asynchronous provider operation is waiting, but has no active
  /// lease in that state.
  attemptId             String?   @db.Uuid
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  heartbeatAt           DateTime?
  nextAttemptAt         DateTime?
  nextPollAt            DateTime?
  waitingSince          DateTime?
  requestedCount        Int?
  succeededCount        Int?
  failedCount           Int?
  /// Fixed-membership marker for a clip-rendering Render Work Set. Null means
  /// this run has not frozen a Render Work Set.
  renderWorkSetFrozenAt DateTime?
  /// Stable across coordinator claims. Allocated once with group membership.
  renderWorkSetGeneration String? @db.Uuid
  // The immutable configuration bound to a generation run. Detection reads
  // this pack, never "latest for project"; a missing binding fails permanently.
  // Render rescue and dubbing can run without a ContentPack binding.
  contentPackId         String?   @db.Uuid
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentPack    ContentPack?         @relation(fields: [contentPackId], references: [id], onDelete: SetNull)
  renderVariants ClipRender[]
  renderGroups   RenderGroup[]
  exportBundle   ExportBundle?
  ingestHandoffs IngestJob[]          @relation("IngestJobGenerationRun")
  finishing      GenerationFinishing?

  // Raw partial unique index (not expressible in Prisma schema — see the
  // 20260729000000_one_live_clip_rendering_run migration): at most one
  // clip_rendering run per project may be queued/running at a time. Creation
  // paths must catch the unique violation and reuse the existing live run.
  @@unique([id, renderWorkSetGeneration])
  @@unique([projectId, idempotencyKey])
  @@index([stage, status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([status, nextPollAt])
}

enum RenderGroupStatus {
  queued
  running
  completed
  partial
  failed
  superseded
}

enum RenderGroupExecutionResult {
  completed
  partial
  failed
  interrupted
  released
  superseded
}

enum RenderGroupVariantResult {
  completed
  retryable
  permanent
  superseded
}

/// A partition of one fixed Render Work Set, never another Workflow Run.
/// clipId and exportIdentity are historical identities, not mutable inputs.
model RenderGroup {
  id                    String            @id @default(uuid()) @db.Uuid
  workflowRunId         String            @db.Uuid
  workSetGeneration     String            @db.Uuid
  clipId                String            @db.Uuid
  exportIdentity        String
  status                RenderGroupStatus @default(queued)
  attemptToken          String?           @unique @db.Uuid
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  heartbeatAt           DateTime?
  nextAttemptAt         DateTime?
  chargedAttemptCount   Int               @default(0)
  errorCode             String?
  failureDisposition    ClipRenderFailureDisposition?
  settledAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  workflowRun      WorkflowRun            @relation(fields: [workflowRunId, workSetGeneration], references: [id, renderWorkSetGeneration], onDelete: Cascade, onUpdate: Restrict)
  members          RenderGroupMember[]
  executions       RenderGroupExecution[] @relation("RenderGroupExecutions")
  currentExecution RenderGroupExecution?  @relation("CurrentRenderGroupExecution", fields: [attemptToken, id], references: [token, groupId], onDelete: NoAction, onUpdate: Restrict)

  @@unique([workflowRunId, workSetGeneration, clipId, exportIdentity], map: "RenderGroup_identity_key")
  @@unique([id, workflowRunId, workSetGeneration])
  @@unique([attemptToken, id])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
}

/// Historical membership survives deletion or reassignment of a ClipRender.
/// Admission validates clipRenderId against the group's clip and frozen inputs.
/// Invalidating a member is explicit; it never expands or rewrites the work set.
model RenderGroupMember {
  groupId           String    @db.Uuid
  workflowRunId     String    @db.Uuid
  workSetGeneration String    @db.Uuid
  clipRenderId      String    @db.Uuid
  invalidatedAt     DateTime?
  createdAt         DateTime  @default(now())

  group    RenderGroup                 @relation(fields: [groupId, workflowRunId, workSetGeneration], references: [id, workflowRunId, workSetGeneration], onDelete: Cascade, onUpdate: Restrict)
  outcomes RenderGroupVariantOutcome[]

  @@id([groupId, clipRenderId])
  @@unique([workflowRunId, workSetGeneration, clipRenderId], map: "RenderGroupMember_membership_key")
}

/// One immutable claim token and owner per execution. Execution start and
/// charging commit together; graceful release refunds the charge exactly once.
model RenderGroupExecution {
  token                String                      @id @db.Uuid
  groupId              String                      @db.Uuid
  owner                String
  claimedAt            DateTime                    @default(now())
  startedAt            DateTime?
  finishedAt           DateTime?
  charged              Boolean                     @default(false)
  result               RenderGroupExecutionResult?
  errorCode            String?
  failureDisposition   ClipRenderFailureDisposition?
  sourceFingerprint    String?
  analysisFingerprint  String?
  toolchainFingerprint String?

  group      RenderGroup                 @relation("RenderGroupExecutions", fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  currentFor RenderGroup?                 @relation("CurrentRenderGroupExecution")
  outcomes   RenderGroupVariantOutcome[]

  @@unique([token, groupId])
  @@index([groupId, claimedAt])
}

/// Idempotent execution outcomes remain after mutable variant retries.
/// No URLs, commands, render manifests, or raw user text belong here.
model RenderGroupVariantOutcome {
  token        String                   @db.Uuid
  groupId      String                   @db.Uuid
  clipRenderId String                   @db.Uuid
  result       RenderGroupVariantResult
  errorCode    String?
  recordedAt   DateTime                 @default(now())

  execution RenderGroupExecution @relation(fields: [token, groupId], references: [token, groupId], onDelete: Cascade, onUpdate: Restrict)
  member    RenderGroupMember    @relation(fields: [groupId, clipRenderId], references: [groupId, clipRenderId], onDelete: Cascade, onUpdate: Restrict)

  @@id([token, clipRenderId])
  @@index([groupId, clipRenderId])
}

/// Send-once ledger for terminal-outcome notifications (Phase 2b of the
/// link-first plan). `sourceId` is the WorkflowRun id for generation
/// outcomes and the IngestJob id for import failures. Claim/lease keeps a
/// crashed sender from double-delivering alongside the provider idempotency
/// key.
model NotificationLedger {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @db.Uuid
  sourceId          String    @db.Uuid
  outcome           String
  status            String    @default("pending")
  leaseExpiresAt    DateTime?
  attemptCount      Int       @default(0)
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceId, outcome])
  @@index([status, leaseExpiresAt])
}

/// NOTE: updatedAt doubles as the submit-and-release STT timeout anchor —
/// between provider submission and completion, NOTHING may write this row
/// (a backfill or new mid-flight write would silently disable the overall
/// transcription timeout in processSubmittedTranscriptResults).
model Transcript {
  id                 String              @id @default(uuid()) @db.Uuid
  projectId          String              @unique @db.Uuid
  status             TranscriptStatus    @default(queued)
  provider           String?
  providerModel      String?
  providerJobId      String?
  workflowAttemptId  String?             @db.Uuid
  languageCode       String?
  languageConfidence Float?
  text               String?
  utterancesJson     Json?
  speakerCount       Int?
  durationSeconds    Int?
  errorCode          String?
  rawStorageKey      String?
  completedAt        DateTime?
  /// Library search indexing. `passagesIndexedFor` is the `completedAt` the
  /// passages were built from; a newer `completedAt` means the transcript changed.
  /// `passagesRetryAt` is both the claim lease and the retry backoff. After
  /// 8 attempts the transcript is left alone and `passagesIndexError` names why.
  passagesIndexedFor DateTime?
  passagesAttempts   Int                 @default(0)
  passagesRetryAt    DateTime?
  passagesIndexError String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  passages           TranscriptPassage[]

  @@index([status, updatedAt])
}

/// A 30 to 60 second span of a Transcript, embedded for library search. Rows
/// are written with raw SQL (the vector column is not a Prisma type), and
/// `searchText` is a generated tsvector (`to_tsvector('english', text)`).
/// `workspaceId` is denormalized and every query also joins Project, so a stale
/// value can never leak a passage.
///
/// The cosine HNSW index on `embedding` is created by the migration only:
/// `CREATE INDEX "TranscriptPassage_embedding_idx" ON "TranscriptPassage"
/// USING hnsw ("embedding" public.vector_cosine_ops)`. Prisma cannot express it,
/// so it is the one index that `prisma migrate diff` will not list.
model TranscriptPassage {
  id             String                      @id @default(uuid()) @db.Uuid
  workspaceId    String                      @db.Uuid
  projectId      String                      @db.Uuid
  transcriptId   String                      @db.Uuid
  startMs        Int
  endMs          Int
  text           String
  embedding      Unsupported("vector(1536)")
  embeddingModel String
  contentHash    String
  searchText     Unsupported("tsvector")?    @default(dbgenerated("to_tsvector('english'::regconfig, text)"))
  createdAt      DateTime                    @default(now())
  project        Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transcript     Transcript                  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, contentHash])
  @@index([workspaceId])
  @@index([projectId])
  @@index([searchText], type: Gin)
}

model UploadSession {
  id                           String              @id @default(uuid()) @db.Uuid
  workspaceId                  String              @db.Uuid
  actorUserId                  String              @db.Uuid
  clientIdempotencyKey         String              @db.Uuid
  immutableInputFingerprint    String
  preallocatedProjectId        String              @unique @db.Uuid
  title                        String
  fileName                     String
  fileSizeBytes                BigInt
  contentType                  String
  browserFingerprint           String
  brandTemplateId              String?             @db.Uuid
  brandSnapshot                Json?
  brandProfileId               String?             @db.Uuid
  brandProfileSnapshot         Json?
  generationSettings           Json
  transferKind                 UploadTransferKind
  partSizeBytes                Int?
  partCount                    Int                 @default(1)
  storageKey                   String              @unique
  providerUploadId             String?
  providerInitiatedAt          DateTime?
  status                       UploadSessionStatus @default(initiating)
  admissionAttemptId           String?             @db.Uuid
  admissionClaimExpiresAt      DateTime?
  admissionPreparedAt          DateTime?
  completionParts              Json?
  verifiedSizeBytes            BigInt?
  verifiedContentType          String?
  queuedJobId                  String?             @unique @db.Uuid
  failureCode                  String?
  cleanupRetryAt               DateTime?
  reconcileAt                  DateTime?
  reconciliationAttemptId      String?             @db.Uuid
  reconciliationLeaseExpiresAt DateTime?
  reconciliationAttemptCount   Int                 @default(0)
  expiresAt                    DateTime
  hardExpiresAt                DateTime
  queuedAt                     DateTime?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ingestJob IngestJob? @relation("UploadSessionIngestJob")

  @@unique([workspaceId, clientIdempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([status, expiresAt, cleanupRetryAt])
  @@index([status, admissionClaimExpiresAt])
  @@index([status, reconcileAt, reconciliationLeaseExpiresAt])
}

model IngestJob {
  id                       String          @id @default(uuid()) @db.Uuid
  projectId                String          @db.Uuid
  jobType                  IngestJobType
  payload                  Json
  /// Sealed Google Drive access token of a drive_import job. It exists only
  /// while the job can still download; every terminal transition clears it.
  sourceCredential         String?
  status                   IngestJobStatus @default(queued)
  attemptCount             Int             @default(0)
  claimId                  String?         @db.Uuid
  claimExpiresAt           DateTime?
  generationHandoffAt      DateTime?
