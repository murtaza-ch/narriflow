  @@unique([clipId, fingerprint])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([clipId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
}

