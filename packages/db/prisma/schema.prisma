/// Music/SFX library (docs/plans/vizard-parity.md "Music/SFX library").
/// `userId` null = a curated row managed by content operations using
/// `packages/db/audio-manifest.json` as the catalog (never soft-deleted through
/// the app — curation removals are a manual ops step); non-null = a user's own upload,
/// soft-deletable via `deletedAt`. `moodTags` doubles as mood labels for
/// music and category tags for SFX — same column, interpretation depends on
/// `kind`. `storageKey` is unique because it is also the R2 object identity;
/// two rows must never point at the same object.
model AudioAsset {
  id              String         @id @default(uuid()) @db.Uuid
  kind            AudioAssetKind
  userId          String?        @db.Uuid
  workspaceId     String?        @db.Uuid
  createdByUserId String?        @db.Uuid
  storageKey      String         @unique
  title           String
  moodTags        String[]       @default([])
  durationSec     Float          @default(0)
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?

  user          User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  favorites     AudioAssetFavorite[]
  brandProfiles BrandProfileAudio[]

  @@index([kind, userId])
  @@index([userId, deletedAt, createdAt])
  @@index([workspaceId, deletedAt, createdAt])
}

/// A user's saved/favorited library entries. Kept separate from AudioAsset so
/// curated rows remain globally shared while every account gets its own Saved
/// filter, matching the studio's Audio library interaction model.
