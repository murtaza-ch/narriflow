  failureCode            String?
  failureEvidence        Json?
  failureDisposition     PublicationFailureDisposition?
  nextActionAt           DateTime
  providerCallCount      Int                            @default(0)
  processingDeadline     DateTime
  reconciliationDeadline DateTime
  operationKind          String?
  operationLookupHash    String?                        @unique
  checkpointEncrypted    String?
  currentClaimId         String?                        @unique @db.Uuid
  startedAt              DateTime                       @default(now())
  phaseStartedAt         DateTime                       @default(now())
  terminalAt             DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  socialPost      SocialPost                  @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  frozenState     FrozenPublicationState      @relation(fields: [frozenStateId], references: [id], onDelete: Restrict)
  priorAttempt    SocialPublicationAttempt?   @relation("PublicationAttemptLineage", fields: [priorAttemptId], references: [id], onDelete: Restrict)
  laterAttempts   SocialPublicationAttempt[]  @relation("PublicationAttemptLineage")
  claims          PublicationClaim[]
  receipt         ProviderReceipt?
  analyticsIntent PublicationAnalyticsIntent?
  manualDecisions PublicationManualDecision[]

  @@unique([socialPostId, attemptNumber])
  @@index([phase, nextActionAt, id])
  @@index([socialPostId, createdAt])
}

model PublicationManualDecision {
  id                 String                        @id @default(uuid()) @db.Uuid
  socialPostId       String                        @db.Uuid
  attemptId          String                        @db.Uuid
  workspaceId        String                        @db.Uuid
  actorUserId        String                        @db.Uuid
  kind               PublicationManualDecisionKind
  reason             String
  evidenceKind       PublicationEvidenceKind?
  providerReference  String?
  externalUrl        String?
  ownershipValidated Boolean                       @default(false)
  createdAt          DateTime                      @default(now())

  socialPost SocialPost               @relation(fields: [socialPostId], references: [id], onDelete: Restrict)
  attempt    SocialPublicationAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  workspace  Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor      User                     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([socialPostId, createdAt])
  @@index([attemptId, createdAt])
  @@index([workspaceId, createdAt])
}

model PublicationClaim {
  id             String    @id @db.Uuid
  attemptId      String    @db.Uuid
  claimantId     String
  accountSlotKey String?   @unique @db.Uuid
  leaseExpiresAt DateTime
  heartbeatAt    DateTime
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())

  attempt SocialPublicationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
  @@index([leaseExpiresAt, releasedAt])
}

model ProviderReceipt {
  id                            String         @id @default(uuid()) @db.Uuid
  attemptId                     String         @unique @db.Uuid
  platform                      SocialPlatform
  receiptId                     String
  platformPostId                String?
  externalUrl                   String?
  metrics                       Json?
  providerProcessingStatus      String?
  providerProcessingFailureCode String?
  providerVisibility            String?
  enrichmentClaimId             String?        @unique
  enrichmentLeaseExpiresAt      DateTime?
  enrichmentNextCheckAt         DateTime?
  enrichmentCheckCount          Int            @default(0)
  createdAt                     DateTime       @default(now())
  enrichedAt                    DateTime?

  attempt SocialPublicationAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([platform, receiptId])
  @@index([platform, platformPostId])
  @@index([platform, providerProcessingStatus, enrichedAt, enrichmentNextCheckAt])
}

model PublicationAnalyticsIntent {
  id           String    @id @default(uuid()) @db.Uuid
  attemptId    String    @unique @db.Uuid
  socialPostId String    @db.Uuid
  projectId    String    @db.Uuid
  kind         String
  payload      Json?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  attempt SocialPublicationAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([deliveredAt, createdAt])
  @@index([projectId, createdAt])
}

model SocialPostMetric {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @db.Uuid
  postId           String         @db.Uuid
  platform         SocialPlatform
  views            Int            @default(0)
  likes            Int            @default(0)
  comments         Int            @default(0)
  shares           Int            @default(0)
  saves            Int            @default(0)
  watchTimeSeconds Int?
  metadata         Json?
  capturedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post    SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([projectId, capturedAt])
  @@index([postId, capturedAt])
  @@index([platform, capturedAt])
}

model ProjectAnalyticsEvent {
  id        String             @id @default(uuid()) @db.Uuid
  projectId String             @db.Uuid
  clipId    String?            @db.Uuid
  type      AnalyticsEventType
  platform  SocialPlatform?
  metadata  Json?
  createdAt DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clip    Clip?   @relation(fields: [clipId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([clipId, type])
  @@index([type, createdAt])
}

model ProgramAnalyticsEvent {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @db.Uuid
  actorUserId String             @db.Uuid
  projectId   String?            @db.Uuid
  type        AnalyticsEventType
  metadata    Json
  createdAt   DateTime           @default(now())

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([type, createdAt])
}
