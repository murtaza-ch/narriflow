/// relations, so cleanup survives removal of the source row.
model MediaCleanupObligation {
  id             String    @id @default(uuid()) @db.Uuid
  origin         String
  projectId      String?   @db.Uuid
  clipId         String?   @db.Uuid
  cleanupClass   String
  objectKey      String
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  claimId        String?   @db.Uuid
  claimExpiresAt DateTime?
  failureCode    String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([origin, cleanupClass, objectKey])
  @@index([completedAt, nextAttemptAt, claimExpiresAt])
  @@index([clipId, completedAt])
}

model ClipRender {
  id          String           @id @default(uuid()) @db.Uuid
  clipId      String           @db.Uuid
  aspectRatio ClipAspectRatio
  status      ClipRenderStatus @default(pending)
  storageKey  String?
  sizeBytes   BigInt?
  durationSec Float?
  errorCode   String?
  /// Informational Render Work Set lineage. Workflow Attempt fencing remains
  /// the only authority for mutating this variant.
  workflowRunId String? @db.Uuid
  /// Recovery classification for a failed variant: retryable or permanent.
  /// This remains text so old generated clients stay compatible during the
  /// dark rollout; the database check constraint closes the allowed values.
  failureDisposition String?
  /// Fencing reference to the parent Workflow Attempt. It is not an
  /// independent lease or retry counter.
  workflowAttemptId String?          @db.Uuid
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  /// Resolution this render was produced at ("720p" | "1080p", validated at
  /// the application layer by clipRenderResolutionSchema — vizard-parity
  /// Phase C export options). Non-null, defaults to "1080p". Forward-looking
  /// only: existing free-tier rows predating this column were actually
  /// downscaled to 720p-class output by the worker's old hardcoded
  /// applyFreeTierTreatment flag, but this default does not retroactively
  /// describe what those historical rows were rendered at.
  resolution  String           @default("1080p")

  // Export-bound rows are immutable render jobs. They carry a frozen clip
  // snapshot and survive later editor saves; ordinary rows keep acting as the
  // project's mutable latest-render cache. A partial unique index in the
  // migration preserves one ordinary row per clip/aspect ratio while allowing
  // any number of versioned export rows.
  exportVariantId String? @unique @db.Uuid
  editorRevision  Int?
  clipSnapshot    Json?

  clip          Clip               @relation(fields: [clipId], references: [id], onDelete: Cascade)
  exportVariant ClipExportVariant? @relation(fields: [exportVariantId], references: [id], onDelete: Cascade)
  workflowRun   WorkflowRun?       @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  @@index([clipId])
  @@index([clipId, aspectRatio])
  @@index([workflowRunId, createdAt, id])
}

/// Immutable delivery record for one exact editor revision and normalized
