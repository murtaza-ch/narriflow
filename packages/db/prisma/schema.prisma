  claimId        String?   @db.Uuid
  claimExpiresAt DateTime?
  failureCode    String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([origin, cleanupClass, objectKey])
  @@index([completedAt, nextAttemptAt, claimExpiresAt])
  @@index([clipId, completedAt])
}

model ClipRender {
  id                 String                        @id @default(uuid()) @db.Uuid
  clipId             String                        @db.Uuid
  aspectRatio        ClipAspectRatio
  status             ClipRenderStatus              @default(pending)
  storageKey         String?
  sizeBytes          BigInt?
  durationSec        Float?
  errorCode          String?
  /// Render Work Set lineage. Group membership supplies child mutation
  /// authority after the integrated group runtime is enabled.
  workflowRunId      String?                       @db.Uuid
  /// Recovery classification for a failed variant.
  failureDisposition ClipRenderFailureDisposition?
  /// Parent-only execution fence, removed from runtime use by ticket 20.
  /// Group tokens live in RenderGroup, not in this historical field.
  workflowAttemptId  String?                       @db.Uuid
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  /// Resolution this render was produced at ("720p" | "1080p"), validated by
  /// clipRenderResolutionSchema.
  resolution         String                        @default("1080p")
  /// Caption characters this render could not draw ({ omittedCodePoints,
  /// skippedEmoji }, clipRenderCaptionDiagnosticsSchema). Written when the
  /// worker commits a successful render; null when nothing was left out.
  captionDiagnostics Json?

  // Export-bound rows are immutable render jobs. They carry a frozen clip
  // snapshot and survive later editor saves; ordinary rows keep acting as the
  // project's mutable latest-render cache. A partial unique index in the
  // migration preserves one ordinary row per clip/aspect ratio while allowing
  // any number of versioned export rows.
  exportVariantId String? @unique @db.Uuid
  editorRevision  Int?
  clipSnapshot    Json?

  clip          Clip               @relation(fields: [clipId], references: [id], onDelete: Cascade)
  exportVariant ClipExportVariant? @relation(fields: [exportVariantId], references: [id], onDelete: Cascade)
  workflowRun   WorkflowRun?       @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  @@index([clipId])
  @@index([clipId, aspectRatio])
  @@index([workflowRunId, createdAt, id])
}

/// Immutable delivery record for one exact editor revision and normalized
