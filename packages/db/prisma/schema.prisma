  resend
  stripe
}

enum SocialPlatform {
  tiktok
  youtube_shorts
  instagram_reels
  linkedin
  x
}

enum SocialPostStatus {
  draft
  preparing_video
  scheduled
  publishing
  processing
  reconciling
  posted
  failed
  needs_attention
  cancelled
}

enum PublicationAttemptPhase {
  claimed
  preparing
  uploading
  submission_started
  processing
  reconciling
  retry_scheduled
  succeeded
  failed
  needs_attention
}

enum PublicationOutcome {
  accepted
  pending
  failed
  unknown
}

enum PublicationFailureDisposition {
  safe_retry
  permanent
  attention
}

enum PublicationManualDecisionKind {
  recheck_requested
  confirmed_published
  republish_requested
}

enum PublicationEvidenceKind {
  provider_reference
  platform_url
  manual_unvalidated
}

enum SocialAccountStatus {
  active
  expired
  revoked
}

enum AutopilotStatus {
  active
  paused
  running
  failed
}

enum AutopilotInitialImportMode {
  future_only
  latest
}

enum AnalyticsEventType {
  render_completed
  download_opened
  social_scheduled
  social_cancelled
  social_posted
  social_failed
  dub_completed
  dub_download_opened
}

enum AudioAssetKind {
  music
  sfx
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  title          String
  sourceMediaUrl String
  sourceType     SourceType    @default(upload)
  sourceProvider String?
  sourceInput    String?
  sourceStorageKey String?
  sourceMimeType String?
  sourceSizeBytes BigInt?
  sourceDurationSeconds Int?
  languageCode   String?
  ingestStatus   IngestStatus  @default(pending)
  ingestErrorCode String?
  ingestCompletedAt DateTime?
  userId         String        @db.Uuid
  workspaceId    String        @db.Uuid
  createdByUserId String?      @db.Uuid
  updatedByUserId String?      @db.Uuid
  folderId       String?       @db.Uuid
  brandTemplateId String?      @db.Uuid
  brandSnapshot  Json?
  // Client-minted commit token: concurrent Step-1 double-submits collapse in
  // the database, not the UI.
  commitToken    String?       @unique @db.Uuid
  notifyOnComplete Boolean     @default(true)
  retentionPolicyKey String?
  expiresAt      DateTime?
  purgeStartedAt DateTime?
  purgeLeaseExpiresAt DateTime?
  purgeRetryAt   DateTime?
  purgeAttemptCount Int        @default(0)
  purgeDeletedObjectCount Int  @default(0)
  purgeDeletedBytes BigInt     @default(0)
  purgeStorageVerifiedAt DateTime?
  purgeLastError String?
  /// Monotonic allocator for WorkflowEvent.seq. Updated in the same
  /// transaction as lifecycle transitions and event insertion.
  workflowEventSeq Int          @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  contentPacks   ContentPack[]
  ingestJobs     IngestJob[]
  transcript     Transcript?
  clips          Clip[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder         WorkspaceFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  brandTemplate  BrandTemplate? @relation(fields: [brandTemplateId], references: [id], onDelete: SetNull)
  workflowRuns   WorkflowRun[]
  workflowEvents WorkflowEvent[]
  contentAssets  ContentAsset[]
  socialPosts    SocialPost[]
  socialPostMetrics SocialPostMetric[]
  analyticsEvents ProjectAnalyticsEvent[]
  clipDubs        ClipDub[]
  autopilotEpisodes AutopilotEpisode[]
  notificationLedgers NotificationLedger[]
  clipExports     ClipExport[]

  @@index([userId, createdAt])
  @@index([userId, ingestStatus, createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, ingestStatus, createdAt])
  @@index([workspaceId, folderId, createdAt])
  @@index([brandTemplateId])
  @@index([expiresAt, purgeRetryAt, purgeLeaseExpiresAt])
}

/// Content-free proof that an expired project was removed. This deliberately
/// has no Project foreign key so the receipt survives the project's hard
/// delete and can fence point-in-time restores for 90 days.
model ProjectDeletionReceipt {
  id                 String   @id @default(uuid()) @db.Uuid
  projectIdHash      String   @unique
  retentionPolicyKey String
  expiresAt          DateTime
  purgeCompletedAt   DateTime
  objectCount        Int
  totalBytes         BigInt
  tombstoneStorageKey String
  deleteAfter        DateTime
  createdAt          DateTime @default(now())

  @@index([deleteAfter])
}

/// Repurposed text outputs generated from the transcript (blog, thread,
/// LinkedIn post, show notes, quote cards). One row per (project, type).
model ContentAsset {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  type      OutputType
  title     String
  body      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId, createdAt])
}

model ContentPack {
  id                      String       @id @default(uuid()) @db.Uuid
  projectId               String       @db.Uuid
  outputTypes             OutputType[]
  clipGenerationMode      String       @default("best")
  clipCountTarget         Int
  clipDurationSecTarget   Int
  minDurationSec          Int          @default(15)
  preferredMinDurationSec Int          @default(30)
  preferredMaxDurationSec Int          @default(60)
  maxDurationSec          Int          @default(90)
  platformTargets         String[]     @default(["tiktok", "youtube_shorts", "instagram_reels"])
  autoRenderClips         Boolean      @default(false)
  toneConstraints         Json
  captionPreset           String
  platformPlaybookVersion String
  mode                    String       @default("clip")
  autoHook                Boolean      @default(true)
  specificMoments         String       @default("")
  processingStartSec      Int?
  processingEndSec        Int?
  // Link-first split: Step 1 (Commit) writes a draft; Step 2 (Configure)
  // flips it to committed. A draft must never start generation — every
  // reader takes the latest pack overall and STOPS if it is a draft
  // (filtering drafts out first could silently run an older committed pack).
  // At most one draft per project (partial unique index in the migration —
  // Prisma cannot express it here).
  draft                   Boolean      @default(false)
  clipLengthPreset        String       @default("auto")
  defaultAspectRatio      String       @default("9:16")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRuns WorkflowRun[]
}

model WorkflowRun {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  idempotencyKey String
  stage          String
  status         String
  progress       Int      @default(0)
  errorCode      String?
  // Incremented on each claim. IngestJob has had this field all along but
  // nothing ever read it, so one transient socket error killed a job
  // permanently; WorkflowRun had no equivalent at all, so stt /
  // moment_detection / clip_rendering / dubbing could not be retried either.
  attemptCount   Int      @default(0)
  /// Protocol 1 is the legacy ProjectService lifecycle. Protocol 2 is owned
  /// exclusively by WorkflowRunLifecycle. Kept explicit for rolling deploys.
  lifecycleVersion Int    @default(1)
  /// Immutable identity for the current execution attempt. It remains set
  /// while an asynchronous provider operation is waiting, but has no active
  /// lease in that state.
  attemptId       String?  @db.Uuid
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  heartbeatAt     DateTime?
  nextAttemptAt   DateTime?
  nextPollAt      DateTime?
  waitingSince    DateTime?
  requestedCount  Int?
  succeededCount  Int?
  failedCount     Int?
  /// Fixed-membership marker for a clip-rendering Render Work Set. Null means
  /// the dark-deployed lineage path has never begun for this run.
  renderWorkSetFrozenAt DateTime?
  // The immutable configuration this run was claimed with. Workers read the
  // bound pack, never "latest for project", so a draft written mid-run can
  // never swap an active run's settings. Null only on pre-split legacy runs.
  contentPackId  String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentPack    ContentPack? @relation(fields: [contentPackId], references: [id], onDelete: SetNull)
  renderVariants ClipRender[]

  // Raw partial unique index (not expressible in Prisma schema — see the
  // 20260729000000_one_live_clip_rendering_run migration): at most one
  // clip_rendering run per project may be queued/running at a time. Creation
  // paths must catch the unique violation and reuse the existing live run.
  @@unique([projectId, idempotencyKey])
  @@index([lifecycleVersion, stage, status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([status, nextPollAt])
}

/// Send-once ledger for terminal-outcome notifications (Phase 2b of the
/// link-first plan). `sourceId` is the WorkflowRun id for generation
/// outcomes and the IngestJob id for import failures. Claim/lease keeps a
/// crashed sender from double-delivering alongside the provider idempotency
/// key.
model NotificationLedger {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @db.Uuid
  sourceId          String    @db.Uuid
  outcome           String
  status            String    @default("pending")
  leaseExpiresAt    DateTime?
  attemptCount      Int       @default(0)
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceId, outcome])
  @@index([status, leaseExpiresAt])
}

/// NOTE: updatedAt doubles as the submit-and-release STT timeout anchor —
/// between markTranscriptSubmitted and completion, NOTHING may write this row
/// (a backfill or new mid-flight write would silently disable the overall
/// transcription timeout in processSubmittedTranscriptResults).
model Transcript {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @unique @db.Uuid
  status         TranscriptStatus @default(queued)
  provider       String?
  providerModel  String?
  providerJobId  String?
  workflowAttemptId String?          @db.Uuid
  languageCode       String?
  languageConfidence Float?
  text               String?
  utterancesJson Json?
  speakerCount   Int?
  durationSeconds Int?
  errorCode      String?
  rawStorageKey  String?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model UploadSession {
  id                        String              @id @default(uuid()) @db.Uuid
  workspaceId               String              @db.Uuid
  actorUserId               String              @db.Uuid
  legacyOwnerUserId         String              @db.Uuid
  clientIdempotencyKey      String              @db.Uuid
  immutableInputFingerprint String
  preallocatedProjectId     String              @unique @db.Uuid
  title                     String
  fileName                  String
  fileSizeBytes             BigInt
  contentType               String
  browserFingerprint        String
  brandTemplateId           String?             @db.Uuid
  brandSnapshot             Json?
  generationSettings        Json
  transferKind              UploadTransferKind
  partSizeBytes             Int?
  partCount                 Int                 @default(1)
  storageKey                String              @unique
  providerUploadId          String?
  providerInitiatedAt       DateTime?
  status                    UploadSessionStatus @default(initiating)
  admissionAttemptId        String?             @db.Uuid
  admissionClaimExpiresAt   DateTime?
  admissionPreparedAt       DateTime?
  completionParts           Json?
  verifiedSizeBytes         BigInt?
  verifiedContentType       String?
  queuedJobId               String?             @unique @db.Uuid
  failureCode               String?
  cleanupRetryAt            DateTime?
  reconcileAt               DateTime?
  reconciliationAttemptId   String?             @db.Uuid
  reconciliationLeaseExpiresAt DateTime?
  reconciliationAttemptCount Int                @default(0)
  expiresAt                 DateTime
  hardExpiresAt             DateTime
  queuedAt                  DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ingestJob IngestJob? @relation("UploadSessionIngestJob")

  @@unique([workspaceId, clientIdempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([status, expiresAt, cleanupRetryAt])
  @@index([status, admissionClaimExpiresAt])
  @@index([status, reconcileAt, reconciliationLeaseExpiresAt])
}

model IngestJob {
  id           String          @id @default(uuid()) @db.Uuid
  projectId    String          @db.Uuid
  jobType      IngestJobType
  payload      Json
  status       IngestJobStatus @default(queued)
  attemptCount Int             @default(0)
  lastError    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?
  uploadSessionId String?       @unique @db.Uuid
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadSession UploadSession? @relation("UploadSessionIngestJob", fields: [uploadSessionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([projectId, status, createdAt])
}

model WorkflowEvent {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  workflowRunId String   @db.Uuid
  seq           Int
  stage         String
  status        String
  progress      Int      @default(0)
  errorCode     String?
  emittedAt     DateTime
  /// Null only for protocol-v1 rows created during rolling compatibility.
  dedupeKey     String?  @unique
  eventType     String   @default("workflow.stage.updated")
  payload       Json?
  availableAt   DateTime @default(now())
  deliveryLeaseOwner String?
  deliveryLeaseExpiresAt DateTime?
  deliveryAttempts Int   @default(0)
  nextDeliveryAt DateTime @default(now())
  redisRequired Boolean  @default(false)
  redisPublishedAt DateTime?
  analyticsRequired Boolean @default(false)
  analyticsPublishedAt DateTime?
  /// Terminal render events use this event as their durable notification
  /// intent. Delivery is acknowledged only after the send-once ledger has
  /// durably accepted the handoff.
  notificationRequired Boolean @default(false)
  notificationDeliveredAt DateTime?
  deadLetteredAt DateTime?
  lastDeliveryError String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, seq])
  @@index([projectId, seq])
  @@index([nextDeliveryAt, deliveryLeaseExpiresAt])
  @@index([notificationRequired, notificationDeliveredAt, nextDeliveryAt])
}

model User {
  id                     String           @id @default(uuid()) @db.Uuid
  clerkId                String           @unique
  primaryEmail           String?          @unique
  emailVerifiedAt        DateTime?
  firstName              String?
  lastName               String?
  imageUrl               String?
  onboardingCompletedAt  DateTime?
  lastSignInAt           DateTime?
  defaultBrandTemplateId String?          @db.Uuid
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  authIdentities         AuthIdentity[]
  apiKeys                ApiKey[]
  ownedWorkspaces        Workspace[]       @relation("WorkspaceOwner")
  personalWorkspace      Workspace?        @relation("PersonalWorkspaceOwner")
  projects               Project[]
  autopilotRules         AutopilotRule[]
  socialAccounts         SocialAccount[]
  socialOAuthStates      SocialOAuthState[]
  workspaceMemberships   WorkspaceMember[]
  brandTemplates         BrandTemplate[]  @relation("UserBrandTemplates")
  defaultBrandTemplate   BrandTemplate?   @relation("UserDefaultBrandTemplate", fields: [defaultBrandTemplateId], references: [id], onDelete: SetNull)
  audioAssets            AudioAsset[]
  audioAssetFavorites    AudioAssetFavorite[]
  publicationManualDecisions PublicationManualDecision[]

  @@index([clerkId])
}

model Workspace {
  id                     String          @id @default(uuid()) @db.Uuid
  name                   String
  avatarStorageKey       String?
  ownerUserId            String          @db.Uuid
  personalOwnerUserId    String?         @unique @db.Uuid
  status                 WorkspaceStatus @default(active)
  timezone               String          @default("UTC")
  pricingTier            PricingTier     @default(free)
  defaultBrandTemplateId String?         @db.Uuid
  seatLimit              Int             @default(1)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  owner                User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  personalOwner        User?                 @relation("PersonalWorkspaceOwner", fields: [personalOwnerUserId], references: [id], onDelete: Cascade)
  defaultBrandTemplate BrandTemplate?        @relation("WorkspaceDefaultBrandTemplate", fields: [defaultBrandTemplateId], references: [id], onDelete: SetNull)
  members              WorkspaceMember[]
  invites              WorkspaceInvite[]
  projects             Project[]
  uploadSessions       UploadSession[]
  folders              WorkspaceFolder[]
  autopilotRules       AutopilotRule[]
  apiKeys              ApiKey[]
  socialAccounts       SocialAccount[]
  socialOAuthStates    SocialOAuthState[]
  brandTemplates       BrandTemplate[]
  audioAssets          AudioAsset[]
  audioAssetFavorites  AudioAssetFavorite[]
  clipExports          ClipExport[]
  socialPosts          SocialPost[]
  publicationManualDecisions PublicationManualDecision[]
  billingAccount       WorkspaceBillingAccount?

  @@index([ownerUserId])
  @@index([status, pricingTier])
}

model WorkspaceBillingAccount {
  id                        String    @id @default(uuid()) @db.Uuid
  workspaceId               String    @unique @db.Uuid
  providerCustomerId        String?   @unique
  canonicalSubscriptionId   String?   @unique
  seatItemId                String?   @unique
  billingInterval           String?
  providerStatus            String?
  currentPeriodEndAt        DateTime?
  trialEndAt                DateTime?
  cancelAtPeriodEnd         Boolean   @default(false)
  firstPastDueAt            DateTime?
  graceDeadlineAt           DateTime?
  desiredAdditionalSeats    Int       @default(0)
  synchronizedAdditionalSeats Int?
  seatRevision              Int       @default(0)
  health                    String    @default("current")
  attentionReason           String?
  lastVerifiedAt            DateTime?
  nextReconcileAt           DateTime  @default(now())
  reconcileAttemptId        String?   @db.Uuid
  leaseExpiresAt            DateTime?
  attemptCount              Int       @default(0)
  snapshot                  Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  workspace   Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transitions WorkspaceBillingTransition[]
  deliveries  WebhookDeliveryLog[]
  checkoutAttempts WorkspaceCheckoutAttempt[]

  @@index([nextReconcileAt, id])
  @@index([leaseExpiresAt])
}

model WorkspaceCheckoutAttempt {
  id                   String      @id @default(uuid()) @db.Uuid
  billingAccountId     String      @db.Uuid
  actorUserId          String      @db.Uuid
  clientIdempotencyKey String      @unique
  targetTier           PricingTier
  interval             String
  catalogVersion       String
  returnDestination    String
  customerOperationKey String
  checkoutOperationKey String      @unique
  providerSessionId    String?     @unique
  providerPhase        String      @default("prepared")
  sessionStatus        String?
  paymentStatus        String?
  expiresAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  billingAccount WorkspaceBillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId, createdAt])
}

model WorkspaceBillingTransition {
  id                 String      @id @default(uuid()) @db.Uuid
  billingAccountId   String      @db.Uuid
  previousTier       PricingTier
  nextTier           PricingTier
  previousStatus     WorkspaceStatus
  nextStatus         WorkspaceStatus
  providerStatus     String?
  reason             String
  effectiveAt        DateTime
  observedAt         DateTime
  sourceEventId      String?
  sourceSubscriptionId String?
  createdAt          DateTime    @default(now())

  billingAccount WorkspaceBillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId, createdAt])
}

model WorkspaceMember {
  id                      String        @id @default(uuid()) @db.Uuid
  workspaceId             String        @db.Uuid
  userId                  String        @db.Uuid
  role                    WorkspaceRole @default(viewer)
  joinedAt                DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, joinedAt])
  @@index([workspaceId, role])
}

model WorkspaceInvite {
  id                      String        @id @default(uuid()) @db.Uuid
  workspaceId             String        @db.Uuid
  email                   String
  role                    WorkspaceRole @default(viewer)
  tokenHash               String        @unique
  invitedByUserId         String?       @db.Uuid
  expiresAt               DateTime
  acceptedAt              DateTime?
  revokedAt               DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([workspaceId, expiresAt])
}

model WorkspaceFolder {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  name            String
  normalizedName  String
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, createdAt])
}

model AutopilotRule {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  workspaceId       String?         @db.Uuid
  createdByUserId   String?         @db.Uuid
  updatedByUserId   String?         @db.Uuid
  name              String
  rssUrl            String
  titlePrefix       String?
  brandTemplateId   String?         @db.Uuid
  languageCode      String?
  contentPack       Json
  intervalMinutes   Int             @default(1440)
  maxEpisodesPerRun Int             @default(3)
  feedTitle         String?
  initialImportMode AutopilotInitialImportMode @default(future_only)
  initialImportCount Int            @default(3)
  initializedAt     DateTime?
  lastSeenEpisodeId String?
  lastSeenPublishedAt DateTime?
  etag              String?
  lastModified      String?
  leaseExpiresAt    DateTime?
  consecutiveFailures Int           @default(0)
  status            AutopilotStatus @default(active)
  lastCheckedAt     DateTime?
  lastSuccessAt     DateTime?
  nextRunAt         DateTime        @default(now())
  lastError         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  episodes AutopilotEpisode[]

  @@index([userId, status, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([status, nextRunAt, leaseExpiresAt])
}

model AutopilotEpisode {
  id         String   @id @default(uuid()) @db.Uuid
  ruleId     String   @db.Uuid
  episodeId  String
  projectId  String?  @db.Uuid
  importedAt DateTime @default(now())

