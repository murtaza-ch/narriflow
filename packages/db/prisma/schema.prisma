generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum PricingTier {
  free
  starter
  creator
  pro
}

enum OutputType {
  short_clip
  audiogram
  linkedin_carousel
  x_thread
  newsletter_excerpt
  blog_post
  show_notes
  quote_cards
  thumbnail_set
}

enum SourceType {
  upload
  youtube
  rss
  link
}

enum IngestStatus {
  pending
  uploading
  queued
  downloading
  normalizing
  ready
  failed
}

enum UploadSessionStatus {
  initiated
  completed
  aborted
  expired
}

enum IngestJobType {
  upload_finalize
  youtube_import
  rss_import
  link_import
}

enum IngestJobStatus {
  queued
  running
  completed
  failed
}

enum TranscriptStatus {
  queued
  processing
  completed
  failed
}

enum ClipStatus {
  detected
  accepted
  rejected
  edited
}

enum ClipCategory {
  hook
  insight
  story
  humor
  controversy
  emotional
  tutorial
  quote
  debate
  surprise
}

enum ClipRenderStatus {
  pending
  rendering
  completed
  failed
}

enum DubStatus {
  queued
  processing
  completed
  failed
}

enum ClipAspectRatio {
  ratio_9_16
  ratio_1_1
  ratio_16_9
  ratio_4_5
}

enum AuthProvider {
  google
  facebook
  microsoft
  email_password
}

enum TeamRole {
  admin
  editor
  viewer
}

enum WebhookProvider {
  clerk
  resend
}

enum SocialPlatform {
  tiktok
  youtube_shorts
  instagram_reels
  linkedin
  x
}

enum SocialPostStatus {
  draft
  scheduled
  publishing
  posted
  failed
  cancelled
}

enum SocialAccountStatus {
  active
  expired
  revoked
}

enum AutopilotStatus {
  active
  paused
  running
  failed
}

enum AnalyticsEventType {
  render_completed
  download_opened
  social_scheduled
  social_cancelled
  social_posted
  social_failed
  dub_completed
  dub_download_opened
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  title          String
  sourceMediaUrl String
  sourceType     SourceType    @default(upload)
  sourceProvider String?
  sourceInput    String?
  sourceStorageKey String?
  sourceMimeType String?
  sourceSizeBytes BigInt?
  sourceDurationSeconds Int?
  languageCode   String?
  ingestStatus   IngestStatus  @default(pending)
  ingestErrorCode String?
  ingestCompletedAt DateTime?
  userId         String        @db.Uuid
  brandTemplateId String?      @db.Uuid
  brandSnapshot  Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  contentPacks   ContentPack[]
  uploadSessions UploadSession[]
  ingestJobs     IngestJob[]
  transcript     Transcript?
  clips          Clip[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandTemplate  BrandTemplate? @relation(fields: [brandTemplateId], references: [id], onDelete: SetNull)
  workflowRuns   WorkflowRun[]
  workflowEvents WorkflowEvent[]
  contentAssets  ContentAsset[]
  socialPosts    SocialPost[]
  socialPostMetrics SocialPostMetric[]
  analyticsEvents ProjectAnalyticsEvent[]
  clipDubs        ClipDub[]

  @@index([userId, createdAt])
  @@index([userId, ingestStatus, createdAt])
  @@index([brandTemplateId])
}

/// Repurposed text outputs generated from the transcript (blog, thread,
/// LinkedIn post, show notes, quote cards). One row per (project, type).
model ContentAsset {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  type      OutputType
  title     String
  body      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId, createdAt])
}

model ContentPack {
  id                      String       @id @default(uuid()) @db.Uuid
  projectId               String       @db.Uuid
  outputTypes             OutputType[]
  clipGenerationMode      String       @default("best")
  clipCountTarget         Int
  clipDurationSecTarget   Int
  minDurationSec          Int          @default(15)
  preferredMinDurationSec Int          @default(30)
  preferredMaxDurationSec Int          @default(60)
  maxDurationSec          Int          @default(90)
  platformTargets         String[]     @default(["tiktok", "youtube_shorts", "instagram_reels"])
  autoRenderClips         Boolean      @default(false)
  toneConstraints         Json
  captionPreset           String
  platformPlaybookVersion String
  mode                    String       @default("clip")
  autoHook                Boolean      @default(true)
  specificMoments         String       @default("")
  processingStartSec      Int?
  processingEndSec        Int?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WorkflowRun {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  idempotencyKey String
  stage          String
  status         String
  progress       Int      @default(0)
  errorCode      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
}

model Transcript {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @unique @db.Uuid
  status         TranscriptStatus @default(queued)
  provider       String?
  providerModel  String?
  providerJobId  String?
  languageCode   String?
  text           String?
  utterancesJson Json?
  speakerCount   Int?
  durationSeconds Int?
  errorCode      String?
  rawStorageKey  String?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model UploadSession {
  id               String              @id @default(uuid()) @db.Uuid
  projectId        String              @db.Uuid
  providerUploadId String
  storageKey       String
  partCount        Int
  expiresAt        DateTime
  status           UploadSessionStatus @default(initiated)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, providerUploadId])
  @@index([projectId, status, createdAt])
  @@index([expiresAt])
}

model IngestJob {
  id           String          @id @default(uuid()) @db.Uuid
  projectId    String          @db.Uuid
  jobType      IngestJobType
  payload      Json
  status       IngestJobStatus @default(queued)
  attemptCount Int             @default(0)
  lastError    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([projectId, status, createdAt])
}

model WorkflowEvent {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  workflowRunId String   @db.Uuid
  seq           Int
  stage         String
  status        String
  progress      Int      @default(0)
  errorCode     String?
  emittedAt     DateTime
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, seq])
  @@index([projectId, seq])
}

model User {
  id                     String           @id @default(uuid()) @db.Uuid
  clerkId                String           @unique
  primaryEmail           String?          @unique
  emailVerifiedAt        DateTime?
  firstName              String?
  lastName               String?
  imageUrl               String?
  pricingTier            PricingTier      @default(free)
  onboardingCompletedAt  DateTime?
  lastSignInAt           DateTime?
  stripeCustomerId       String?          @unique
  defaultBrandTemplateId String?          @db.Uuid
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  authIdentities         AuthIdentity[]
  apiKeys                ApiKey[]
  ownedTeams             Team[]           @relation("TeamOwner")
  projects               Project[]
  autopilotRules         AutopilotRule[]
  socialAccounts         SocialAccount[]
  socialOAuthStates      SocialOAuthState[]
  teamMemberships        TeamMember[]
  brandTemplates         BrandTemplate[]  @relation("UserBrandTemplates")
  defaultBrandTemplate   BrandTemplate?   @relation("UserDefaultBrandTemplate", fields: [defaultBrandTemplateId], references: [id], onDelete: SetNull)

  @@index([clerkId])
}

model AutopilotRule {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  name              String
  rssUrl            String
  titlePrefix       String?
  brandTemplateId   String?         @db.Uuid
  languageCode      String?
  contentPack       Json
  intervalMinutes   Int             @default(1440)
  maxEpisodesPerRun Int             @default(3)
  status            AutopilotStatus @default(active)
  lastCheckedAt     DateTime?
  nextRunAt         DateTime        @default(now())
  lastError         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes AutopilotEpisode[]

  @@index([userId, status, createdAt])
  @@index([status, nextRunAt])
}

model AutopilotEpisode {
  id         String   @id @default(uuid()) @db.Uuid
  ruleId     String   @db.Uuid
  episodeId  String
  projectId  String?  @db.Uuid
  importedAt DateTime @default(now())

  rule AutopilotRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, episodeId])
  @@index([projectId])
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  email          String?
  linkedAt       DateTime     @default(now())
  lastUsedAt     DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  ownerUserId String       @db.Uuid
  seatLimit   Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invites     TeamInvite[]
  members     TeamMember[]
  owner       User         @relation("TeamOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
}

model TeamMember {
  id       String   @id @default(uuid()) @db.Uuid
  teamId   String   @db.Uuid
  userId   String   @db.Uuid
  role     TeamRole @default(viewer)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvite {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @db.Uuid
  email      String
  role       TeamRole @default(viewer)
  tokenHash  String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, email])
}

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  name         String
  prefix       String    @unique
  hashedSecret String
  scopes       String[]
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model SocialAccount {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @db.Uuid
  platform              SocialPlatform
  providerAccountId     String
  displayName           String
  handle                String?
  avatarUrl             String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  scopes                String[]            @default([])
  expiresAt             DateTime?
  status                SocialAccountStatus @default(active)
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialPosts SocialPost[]

  @@unique([userId, platform, providerAccountId])
  @@index([userId, platform, status])
  @@index([status, expiresAt])
}

model SocialOAuthState {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  platform     SocialPlatform
  state        String         @unique
  codeVerifier String?
  redirectPath String?
  expiresAt    DateTime
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, createdAt])
  @@index([expiresAt])
}

model WebhookDeliveryLog {
  id          String          @id @default(uuid()) @db.Uuid
  provider    WebhookProvider
  eventId     String
  eventType   String
  status      String
  payload     Json?
  processedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventType, createdAt])
}

model Clip {
  id              String       @id @default(uuid()) @db.Uuid
  projectId       String       @db.Uuid
  workflowRunId   String       @db.Uuid
  index           Int
  status          ClipStatus   @default(detected)
  startSec        Float
  endSec          Float
  title           String?
  hookText        String
  payoffText      String?
  reasoning       String
  category        ClipCategory
  platformFit     String[]     @default([])
  transcriptSlice Json
  captionPreset   Json?
  brollUrl        String?
  studioEdits     Json?

  // LLM-suggested B-roll cutaway moments produced by the clip-detection call:
  // [{ atSec, query, reason }], atSec relative to the clip's own start. Without
  // this the detector's cues are computed and then thrown away, and the render
  // falls back to keyword-derived Pexels queries.
  brollCues       Json?

  // Lightweight 540p faststart proxy covering this clip's range (plus padding
  // for boundary tweaks). The studio and the clip cards play this instead of
  // the multi-hundred-MB source, which is what made the editor take 44s to show
  // a first frame. `previewStartSec` is the proxy's t=0 in source time, so
  // player time maps back to source time.
  previewStorageKey  String?
  previewStartSec    Float?
  previewDurationSec Float?

  viralityScore           Int
  hookStrengthScore       Int
  emotionalIntensityScore Int
  storyCompletenessScore  Int    @default(50)
  pacingScore             Int
  durationOptimalityScore Int

  tiktokScore    Int
  youtubeScore   Int
  instagramScore Int

  llmProvider   String
  llmModel      String
  llmTokensUsed Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  renders ClipRender[]
  socialPosts SocialPost[]
  analyticsEvents ProjectAnalyticsEvent[]
  dubs ClipDub[]

  @@index([projectId, viralityScore(sort: Desc)])
  @@unique([projectId, workflowRunId, index])
}

model ClipRender {
  id          String           @id @default(uuid()) @db.Uuid
  clipId      String           @db.Uuid
  aspectRatio ClipAspectRatio
  status      ClipRenderStatus @default(pending)
  storageKey  String?
  sizeBytes   BigInt?
  durationSec Float?
  errorCode   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([clipId, aspectRatio])
  @@index([clipId])
}

model ClipDub {
  id                 String          @id @default(uuid()) @db.Uuid
  projectId          String          @db.Uuid
  clipId             String          @db.Uuid
  aspectRatio        ClipAspectRatio @default(ratio_9_16)
  targetLanguageCode String
  voice              String
  provider           String          @default("openai")
  model              String
  status             DubStatus       @default(queued)
  transcriptText     String?
  translatedText     String?
  audioStorageKey    String?
  renderStorageKey   String?
  audioSizeBytes     BigInt?
  renderSizeBytes    BigInt?
  durationSec        Float?
  errorCode          String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clip    Clip    @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([clipId, targetLanguageCode, voice, aspectRatio])
  @@index([projectId, status, createdAt])
  @@index([clipId, status])
}

model BrandTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  name           String
  isBuiltIn      Boolean  @default(false)
  builtInKey     String?  @unique

  captionPreset  Json

  logoStorageKey String?
  logoPosition   String   @default("bot-right")
  logoOpacity    Int      @default(80)
  logoScalePct   Int      @default(15)

  primaryColor   String   @default("#FFFFFF")
  secondaryColor String   @default("#00FF88")
  accentColor    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  user           User?    @relation("UserBrandTemplates", fields: [userId], references: [id], onDelete: Cascade)
  defaultForUsers User[]  @relation("UserDefaultBrandTemplate")
  projects       Project[]

  @@index([userId, deletedAt, createdAt])
  @@index([isBuiltIn])
}

model SocialPost {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @db.Uuid
  clipId       String?          @db.Uuid
  socialAccountId String?       @db.Uuid
  platform     SocialPlatform
  status       SocialPostStatus @default(scheduled)
  caption      String
  aspectRatio  ClipAspectRatio?
  scheduledFor DateTime?
  postedAt     DateTime?
  externalUrl  String?
  errorCode    String?
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clip    Clip?   @relation(fields: [clipId], references: [id], onDelete: SetNull)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  metrics SocialPostMetric[]

  @@index([projectId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([clipId])
  @@index([socialAccountId])
}

model SocialPostMetric {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @db.Uuid
  postId           String         @db.Uuid
  platform         SocialPlatform
  views            Int            @default(0)
  likes            Int            @default(0)
  comments         Int            @default(0)
  shares           Int            @default(0)
  saves            Int            @default(0)
  watchTimeSeconds Int?
  metadata         Json?
  capturedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post    SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([projectId, capturedAt])
  @@index([postId, capturedAt])
  @@index([platform, capturedAt])
}

model ProjectAnalyticsEvent {
  id        String             @id @default(uuid()) @db.Uuid
  projectId String             @db.Uuid
  clipId    String?            @db.Uuid
  type      AnalyticsEventType
  platform  SocialPlatform?
  metadata  Json?
  createdAt DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clip    Clip?   @relation(fields: [clipId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([clipId, type])
  @@index([type, createdAt])
}
