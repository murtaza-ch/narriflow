  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  owner                      User                             @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  personalOwner              User?                            @relation("PersonalWorkspaceOwner", fields: [personalOwnerUserId], references: [id], onDelete: Cascade)
  defaultBrandTemplate       BrandTemplate?                   @relation("WorkspaceDefaultBrandTemplate", fields: [defaultBrandTemplateId], references: [id], onDelete: SetNull)
  defaultBrandProfile        BrandProfile?                    @relation("WorkspaceDefaultBrandProfile", fields: [defaultBrandProfileId], references: [id], onDelete: SetNull)
  members                    WorkspaceMember[]
  invites                    WorkspaceInvite[]
  projects                   Project[]
  uploadSessions             UploadSession[]
  folders                    WorkspaceFolder[]
  autopilotRules             AutopilotRule[]
  apiKeys                    ApiKey[]
  socialAccounts             SocialAccount[]
  socialOAuthStates          SocialOAuthState[]
  brandTemplates             BrandTemplate[]
  brandProfiles              BrandProfile[]                   @relation("WorkspaceBrandProfiles")
  visualAssets               VisualAsset[]
  generatedMediaJobs         GeneratedMediaJob[]
  assistedCopyGenerations    AssistedCopyGeneration[]
  thumbnailFrameOperations   ThumbnailFrameOperation[]
  generatedMediaUsage        GeneratedMediaUsageReservation[]
  brandFonts                 BrandFont[]
  audioAssets                AudioAsset[]
  audioAssetFavorites        AudioAssetFavorite[]
  clipExports                ClipExport[]
  campaignOperations         CampaignOperation[]
  reviewRounds               ReviewRound[]
  reviewApprovalOverrides    ReviewApprovalOverride[]
  socialPosts                SocialPost[]
  publicationManualDecisions PublicationManualDecision[]
  billingAccount             WorkspaceBillingAccount?

  @@index([ownerUserId])
  @@index([status, pricingTier])
}

