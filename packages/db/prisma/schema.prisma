model Clip {
  id              String       @id @default(uuid()) @db.Uuid
  projectId       String       @db.Uuid
  workflowRunId   String       @db.Uuid
  index           Int
  status          ClipStatus   @default(detected)
  startSec        Float
  endSec          Float
  title           String?
  hookText        String
  payoffText      String?
  reasoning       String
  category        ClipCategory
  platformFit     String[]     @default([])
  transcriptSlice Json
  captionPreset   Json?
  brollUrl        String?
  studioEdits     Json?

  // Studio editor document (docs/plans/vizard-parity.md Phase A): optimistic-
  // concurrency revision bumped by every real editor-document save,
  // ripple-delete ranges in absolute source seconds, and the immutable
  // revision-zero snapshot captured on first save — Reset-to-original
  // restores from it, so later boundary/transcript writes can never destroy
  // the starting point.
  editorRevision        Int   @default(0)
  editorDocumentVersion Int   @default(2)
  deletedRanges         Json?
  editorOriginal        Json?
  sceneBlocks           Json  @default("[]")
  censorSegments        Json  @default("[]")
  mediaMotions          Json  @default("[]")

  // LLM-suggested B-roll cutaway moments produced by the clip-detection call:
  // [{ atSec, query, reason }], atSec relative to the clip's own start. Without
  // this the detector's cues are computed and then thrown away, and the render
  // falls back to keyword-derived Pexels queries.
  brollCues Json?

  // Screen-mode layout analysis (vizard-parity.md element-segmentation spike,
  // landed fc5acb1): the worker's `pip_detect.py`/`classifyScreencast`/
  // `selectPipRect` pass over this clip's source range, persisted so the
  // render path stops re-running detection on every render/output and the
  // studio preview can show the true facecam PiP crop instead of a face-
  // centered band guess. Parsed through `clipLayoutAnalysisSchema`
  // (validators) — a versioned envelope, NOT the raw `pip_detect.py`/
  // `PipCandidate[]` shape (those are analysis-time intermediates; only the
  // SELECTED, post-gate `pipRect` is durable). NULL means "never analyzed"
  // (worker hasn't run the pass, or the pass errored/was unavailable) —
  // distinct from an analyzed-but-non-screencast clip, which stores a
  // non-null envelope with `pipRect: null`. Derived data, not a user edit:
  // written outside the editorRevision-guarded save path (see
  // `setClipLayoutAnalysis`'s doc comment).
  layoutAnalysis Json?

  // Versioned, worker-derived Automatic speaker-layout plan shared by the
  // studio preview and final renderer. Kept separate from layoutAnalysis,
  // whose v1 envelope is screen-share/PiP specific. Parsed through
  // clipAutoLayoutAnalysisSchema; source-boundary/deleted-range edits null it.
  autoLayoutAnalysis       Json?
  // Explicit Split detector evidence uses the same bounded scene-envelope
  // shape but a distinct engine and column, so Automatic and Split can both
  // remain durable without silently replacing or reinterpreting each other.
  splitLayoutAnalysis      Json?
  // Durable, indexed work state for auto-layout analysis. The token fences
  // stale workers and the lease lets another replica recover abandoned work
  // without two healthy replicas paying for the same download/detection.
  autoLayoutStatus         ClipAutoLayoutStatus @default(pending)
  autoLayoutClaimToken     String?              @db.Uuid
  autoLayoutLeaseExpiresAt DateTime?
  autoLayoutAttemptCount   Int                  @default(0)

  // Lightweight 540p faststart proxy covering this clip's range (plus padding
  // for boundary tweaks). The studio and the clip cards play this instead of
  // the multi-hundred-MB source, which is what made the editor take 44s to show
  // a first frame. `previewStartSec` is the proxy's t=0 in source time, so
  // player time maps back to source time.
  previewStorageKey  String?
  previewStartSec    Float?
  previewDurationSec Float?

  viralityScore           Int
  hookStrengthScore       Int
  emotionalIntensityScore Int
  storyCompletenessScore  Int @default(50)
  pacingScore             Int
  durationOptimalityScore Int

  tiktokScore    Int
  youtubeScore   Int
  instagramScore Int

  llmProvider   String
  llmModel      String
  llmTokensUsed Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project                  Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  renders                  ClipRender[]
  socialPosts              SocialPost[]
  analyticsEvents          ProjectAnalyticsEvent[]
  dubs                     ClipDub[]
  exports                  ClipExport[]
  campaignOperationItems   CampaignOperationItem[]
  reviewRoundItems         ReviewRoundItem[]
  generatedMediaJobs       GeneratedMediaJob[]
  assistedCopyGenerations  AssistedCopyGeneration[]
  thumbnailFrameOperations ThumbnailFrameOperation[]

  @@unique([projectId, workflowRunId, index])
  @@index([projectId, viralityScore(sort: Desc)])
  @@index([autoLayoutStatus, autoLayoutLeaseExpiresAt])
}

/// Durable, fenced exact-key deletion work admitted by approved media producers.
/// Project and Clip identifiers are stable diagnostic facts, not cascading
/// relations, so cleanup survives removal of the source row.
model MediaCleanupObligation {
  id             String    @id @default(uuid()) @db.Uuid
  origin         String
  projectId      String?   @db.Uuid
