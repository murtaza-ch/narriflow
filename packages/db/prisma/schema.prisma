  short_clip
  audiogram
  linkedin_carousel
  x_thread
  newsletter_excerpt
  blog_post
  show_notes
  quote_cards
  thumbnail_set
}

enum SourceType {
  upload
  youtube
  rss
  link
}

enum IngestStatus {
  pending
  uploading
  queued
  downloading
  normalizing
  ready
  failed
}

enum UploadSessionStatus {
  initiating
  uploading
  finalizing
  reconciling
  compensating
  queued_for_ingest
  aborted
  expired
  failed
}

enum UploadTransferKind {
  single
  multipart
}

enum IngestJobType {
  upload_finalize
  youtube_import
  rss_import
  link_import
}

enum IngestJobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum TranscriptStatus {
  queued
  processing
  completed
  failed
}

enum ClipStatus {
  detected
  accepted
  rejected
  edited
}

enum ClipAutoLayoutStatus {
  pending
  processing
  completed
}

enum ClipCategory {
  hook
  insight
  story
  humor
  controversy
  emotional
  tutorial
  quote
  debate
  surprise
}

enum ClipRenderStatus {
  pending
  rendering
  completed
  failed
}

enum ClipExportStatus {
  queued
  rendering
  partial_ready
  ready
  failed
}

enum DubStatus {
  queued
  processing
  completed
  failed
}

enum ClipAspectRatio {
  ratio_9_16
  ratio_1_1
  ratio_16_9
  ratio_4_5
}

enum AuthProvider {
  google
  facebook
  microsoft
  email_password
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

enum WorkspaceStatus {
  active
  pending_payment
  restricted
}

enum WebhookProvider {
