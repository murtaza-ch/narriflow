enum GenerationUsageKind {
  image
  dub
}

/// One Workspace-owned count for one AI image request or one voice-over dub.
/// `jobId` is the subject id (a Generated Media Job or a Clip Dub) and has no
/// foreign key: deleting the output, Project, or actor never refunds a count.
/// `periodStart` pins the UTC admission month; the Free image sample is the
/// `trial_metered` policy, counted for the Workspace's lifetime.
model GeneratedMediaUsageReservation {
  id          String                    @id @default(uuid()) @db.Uuid
  jobId       String                    @unique @db.Uuid
  kind        GenerationUsageKind
  workspaceId String                    @db.Uuid
  actorUserId String?                   @db.Uuid
  policy      String
  periodStart DateTime
  status      GeneratedMediaUsageStatus @default(reserved)
  actualUnits Int?
  reason      String?
  /// Set when the subject row commits. Null means admission stopped before
  /// any subject existed, so no provider work can have started.
  attachedAt  DateTime?
  createdAt   DateTime                  @default(now())
  settledAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, kind, periodStart, status])
  @@index([workspaceId, kind, policy, status])
  @@index([status, createdAt])
  @@index([actorUserId, createdAt])
}

/// One Workspace-owned claim on a UTC month's credits for one intake, keyed
/// by its Project ID. Debits are whole credits stored as seconds (multiples of
/// 60, enforced by check constraints). The Project ID deliberately has no foreign
/// key: deleting or purging a Project must never cascade into settled usage.
model ProcessingUsageReservation {
  id               String               @id @default(uuid()) @db.Uuid
  projectId        String               @unique @db.Uuid
  workspaceId      String               @db.Uuid
  actorUserId      String?              @db.Uuid
  intakeKind       ProcessingIntakeKind
  /// UTC month start of admission. Settlement never moves usage between months.
  periodStart      DateTime
  reservedSeconds  Int
  settledSeconds   Int?
  state            ProcessingUsageState @default(reserved)
  /// Bounded release or refund reason.
  reason           String?
  refundedByUserId String?              @db.Uuid
  settledAt        DateTime?
  releasedAt       DateTime?
  refundedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, periodStart, state])
  @@index([state, updatedAt])
}

