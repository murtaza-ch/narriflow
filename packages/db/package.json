{
  "name": "@narriflow/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://user:password@localhost:5432/narriflow?schema=public} prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push:test": "prisma db push",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://user:password@localhost:5432/narriflow?schema=public} prisma validate",
    "build": "bun run prisma:generate && tsc -p tsconfig.build.json",
    "typecheck": "bun run prisma:generate && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "bun test src"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "pg": "8.17.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "prisma": "7.7.0",
    "@types/pg": "8.15.5"
  }
}
