{
  "name": "@narriflow/validators",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "default": "./src/api/*.ts"
    },
    "./clip-preview-peaks": {
      "types": "./src/clip-preview-peaks.ts",
      "default": "./src/clip-preview-peaks.ts"
    },
    "./review-selection": {
      "types": "./src/review-selection.ts",
      "default": "./src/review-selection.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
