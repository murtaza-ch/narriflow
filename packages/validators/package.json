    },
    "./review-selection": {
      "types": "./src/review-selection.ts",
      "default": "./src/review-selection.ts"
    },
    "./native-validation": {
      "types": "./src/native-validation.ts",
      "default": "./src/native-validation.ts"
    },
    "./execution-transfer": {
      "types": "./src/execution-transfer.ts",
      "default": "./src/execution-transfer.ts"
    },
    "./outbound-probe": {
      "types": "./src/outbound-probe.ts",
      "default": "./src/outbound-probe.ts"
    },
    "./outbound-delivery": {
      "types": "./src/outbound-delivery.ts",
      "default": "./src/outbound-delivery.ts"
    },
