    },
    "./dubbing-execution": "./src/dubbing-execution.ts",
    "./publication-input": "./src/publication-input.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.3.6"
