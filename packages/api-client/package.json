{
  "name": "@narriflow/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./openapi": {
      "types": "./src/openapi/index.ts",
      "default": "./src/openapi/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@narriflow/api": "workspace:*",
    "@narriflow/validators": "workspace:*",
    "@tanstack/query-core": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "eventsource-parser": "^4.1.3",
    "hono": "^4.13.11"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "react": "19.2.8"
  }
}
