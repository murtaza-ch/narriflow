{
  "name": "@narriflow/services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./project": {
      "types": "./src/project.service.ts",
      "default": "./src/project.service.ts"
    },
    "./workflow": {
      "types": "./src/workflow.service.ts",
      "default": "./src/workflow.service.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "echo 'services lint: no-op'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.923.0",
    "@aws-sdk/s3-request-presigner": "^3.923.0",
    "@narriflow/db": "workspace:*",
    "@narriflow/email": "workspace:*",
    "@narriflow/validators": "workspace:*",
    "@prisma/client": "^7.4.2",
    "fast-xml-parser": "^5.10.1",
    "ioredis": "^5.9.3",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  }
}
