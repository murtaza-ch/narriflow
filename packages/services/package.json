{
  "name": "@narriflow/services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./project": {
      "types": "./src/project.service.ts",
      "default": "./src/project.service.ts"
    },
    "./workflow": {
      "types": "./src/workflow.service.ts",
      "default": "./src/workflow.service.ts"
    },
    "./workflow-attempt-contract": {
      "types": "./src/workflow-attempt-contract.ts",
      "default": "./src/workflow-attempt-contract.ts"
    },
    "./brand-font-parser": {
      "types": "./src/brand-font-parser.ts",
      "default": "./src/brand-font-parser.ts"
    },
    "./clip-editor-document-codec": {
      "types": "./src/clip-editor-document-codec.ts",
      "default": "./src/clip-editor-document-codec.ts"
    },
    "./motion-render-analytics": {
      "types": "./src/motion-render-analytics.ts",
      "default": "./src/motion-render-analytics.ts"
    },
    "./render-group-contract": {
      "types": "./src/render-group-contract.ts",
      "default": "./src/render-group-contract.ts"
    },
    "./url-guard": {
      "types": "./src/url-guard.ts",
      "default": "./src/url-guard.ts"
    },
    "./pexels-contract": {
      "types": "./src/pexels-contract.ts",
      "default": "./src/pexels-contract.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "billing:operator": "bun scripts/workspace-billing-operator.ts",
    "generated-media:operator": "bun scripts/generated-media-operator.ts",
    "social-publication:operator": "bun scripts/social-publication-operator.ts",
    "clean": "rm -rf dist",
    "test:integration-api:db": "bun scripts/run-integration-api-db-tests.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.923.0",
    "@aws-sdk/s3-request-presigner": "^3.923.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@narriflow/composition-plan": "workspace:*",
    "@narriflow/db": "workspace:*",
    "@narriflow/email": "workspace:*",
    "@narriflow/validators": "workspace:*",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^7.4.2",
    "fast-xml-parser": "^5.11.2",
    "fontkit": "2.0.4",
    "ioredis": "^5.9.3",
    "sharp": "^0.35.5",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.7.0",
    "@types/fontkit": "2.0.8",
    "@types/node": "26.2.0",
    "@types/pg": "8.15.5",
    "pg": "8.16.3",
    "standardwebhooks": "^1.1.1"
  }
}
