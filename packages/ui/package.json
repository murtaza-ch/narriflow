{
  "name": "@narriflow/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./provider": "./src/provider.tsx",
    "./theme": "./src/theme.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "echo 'ui lint: no-op'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'ui test: no-op'",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "next": "^16.0.0",
    "framer-motion": "^12.0.0"
  },
  "dependencies": {
    "@chakra-ui/react": "latest",
    "@emotion/react": "latest",
    "@hookform/resolvers": "^5.2.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react-hook-form": "^7.71.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
