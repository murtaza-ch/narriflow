{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_AUTOMATIC_SPEAKER_LAYOUT",
        "NEXT_PUBLIC_SCREEN_LAYOUT",
        "NEXT_PUBLIC_SPLIT_LAYOUT",
        "WORKER_LAYOUT_ENGINE",
        "WORKER_SCREEN_LAYOUT",
        "WORKER_SPLIT"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "env": [
        "NEXT_PUBLIC_AUTOMATIC_SPEAKER_LAYOUT",
        "NEXT_PUBLIC_SCREEN_LAYOUT",
        "NEXT_PUBLIC_SPLIT_LAYOUT",
        "WORKER_LAYOUT_ENGINE",
        "WORKER_SCREEN_LAYOUT",
        "WORKER_SPLIT"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
