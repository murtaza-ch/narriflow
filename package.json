{
  "name": "narriflow",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun --filter @narriflow/db prisma:generate",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:biome": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "audit:production": "bun audit --production --audit-level=high",
    "clean": "turbo run clean && rm -rf .turbo node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "turbo": "2.8.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "stripe": "^22.3.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "fast-xml-builder": "1.2.1",
    "hono": "4.12.28",
    "ip-address": "10.5.0",
    "nanoid": "3.3.17",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
