{
  "name": "narriflow",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun --filter @narriflow/db prisma:generate && bun --filter @narriflow/ui typegen",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev --parallel --filter=!@narriflow/mcp-server",
    "dev:mcp": "bun --filter @narriflow/mcp-server dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "bun -e 'console.log(\"Fast tests exclude disposable-schema PostgreSQL invariants; run the test:*:db commands separately.\")' && turbo run test",
    "test:workflow:db": "bun packages/services/scripts/run-workflow-db-tests.ts",
    "test:upload-session:db": "bun packages/services/scripts/run-upload-session-db-tests.ts",
    "test:workspace-billing:db": "bun packages/services/scripts/run-workspace-billing-db-tests.ts",
    "test:social-publication:db": "bun packages/services/scripts/run-social-publication-db-tests.ts",
    "test:clip-editor-persistence:db": "bun packages/services/scripts/run-clip-editor-persistence-db-tests.ts",
    "test:authenticated-request-policy:db": "bun apps/web/scripts/run-authenticated-request-policy-db-tests.ts",
    "test:brand-profiles:db": "bun packages/services/scripts/run-brand-profile-db-tests.ts",
    "test:vizard-expansion:db": "bun packages/services/scripts/run-vizard-expansion-db-tests.ts",
    "test:mcp:e2e": "bun --cwd apps/web ../../packages/mcp-core/scripts/e2e-clients.ts",
    "audit:production": "bun audit --production --audit-level=high",
    "clean": "turbo run clean && rm -rf .turbo node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "turbo": "2.8.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "stripe": "^22.5.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.5",
    "fast-xml-builder": "1.2.1",
    "hono": "4.12.28",
    "ip-address": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
