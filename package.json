{
  "name": "narriflow",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun --filter @narriflow/db prisma:generate && bun --filter @narriflow/ui typegen",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev --parallel --filter=!@narriflow/mcp-server",
    "dev:mcp": "bun --filter @narriflow/mcp-server dev",
    "mcp:upload": "bun run --cwd apps/mcp upload",
    "env:check": "bun run scripts/env-check.ts",
    "check:web-split": "bun scripts/check-web-backend-imports.ts",
    "build": "turbo run build",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "bun -e 'console.log(\"Fast tests only. PostgreSQL gates are disabled.\")' && bun test scripts/env-check.test.ts scripts/check-web-backend-imports.test.ts scripts/dev-settings.test.ts && turbo run test",
    "test:mcp:e2e": "bun --cwd apps/api ../../packages/mcp-core/scripts/e2e-clients.ts",
    "audit:production": "bun audit --production --audit-level=high",
    "clean": "turbo run clean && rm -rf .turbo node_modules",
    "test:mcp:integration": "bun test packages/mcp-core/src apps/mcp/src apps/api/src/integration-admission-parity.test.ts apps/api/src/domains/integrations/mcp.test.ts apps/api/src/domains/integrations/mcp-configuration.test.ts apps/api/src/domains/integrations/mcp-upload-http.test.ts apps/api/src/domains/integrations/mcp-upload-handoff.test.ts apps/api/src/domains/integrations/mcp-continuation-principal.test.ts",
    "fetch:local": "bun apps/media/src/local-fetch-agent.ts",
    "verify:local": "bun --no-env-file scripts/verify-local.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "turbo": "2.8.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@neon/config": "^1.9.5"
  },
  "overrides": {
    "brace-expansion": "2.1.7",
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.7",
    "fast-xml-builder": "1.2.1",
    "fast-xml-parser": "5.11.2",
    "hono": "4.13.11",
    "ip-address": "10.5.0",
    "mysql2": "3.22.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "uuid": "11.1.1",
    "pg": "8.17.2",
    "zod": "4.6.7"
  },
  "patchedDependencies": {
    "@chakra-ui/react@3.34.0": "patches/@chakra-ui%2Freact@3.34.0.patch"
  }
}
